{
  "surah": 82,
  "verseCount": 19,
  "verses": [
    {
      "surah": 82,
      "ayah": 1,
      "verseKey": "82:1",
      "arabic": " إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ",
      "translationSq": "Kur qielli të çahet"
    },
    {
      "surah": 82,
      "ayah": 2,
      "verseKey": "82:2",
      "arabic": "وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ",
      "translationSq": "dhe yjet të derdhen;"
    },
    {
      "surah": 82,
      "ayah": 3,
      "verseKey": "82:3",
      "arabic": "وَإِذَا ٱلْبِحَارُ فُجِّرَتْ",
      "translationSq": "kur detet të përzihen"
    },
    {
      "surah": 82,
      "ayah": 4,
      "verseKey": "82:4",
      "arabic": "وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ",
      "translationSq": "dhe varret të rrotullohen,"
    },
    {
      "surah": 82,
      "ayah": 5,
      "verseKey": "82:5",
      "arabic": "عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَأَخَّرَتْ",
      "translationSq": "atëherë çdokush do të mësojë për veprat që ka bërë dhe që ka lënë pa bërë."
    },
    {
      "surah": 82,
      "ayah": 6,
      "verseKey": "82:6",
      "arabic": "يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ",
      "translationSq": "O njeri, ç’të mashtroi ty që nuk i besove Zotit tënd bujar,"
    },
    {
      "surah": 82,
      "ayah": 7,
      "verseKey": "82:7",
      "arabic": "ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ",
      "translationSq": "i Cili të krijoi ty, të dha përmasa të rregullta dhe të harmonizoi"
    },
    {
      "surah": 82,
      "ayah": 8,
      "verseKey": "82:8",
      "arabic": "فِىٓ أَىِّ صُورَةٍ مَّا شَآءَ رَكَّبَكَ",
      "translationSq": "dhe, që të ka mbrujtur në çfarëdo forme që ka dashur?!"
    },
    {
      "surah": 82,
      "ayah": 9,
      "verseKey": "82:9",
      "arabic": "كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ",
      "translationSq": "Por jo! Ju e quani të gënjeshtërt Gjykimin (pas ringjalljes),"
    },
    {
      "surah": 82,
      "ayah": 10,
      "verseKey": "82:10",
      "arabic": "وَإِنَّ عَلَيْكُمْ لَحَـٰفِظِينَ",
      "translationSq": "ndonëse mbi ju ka rojtarë (që ju vëzhgojnë),"
    },
    {
      "surah": 82,
      "ayah": 11,
      "verseKey": "82:11",
      "arabic": "كِرَامًا كَـٰتِبِينَ",
      "translationSq": "shënues të nderuar,"
    },
    {
      "surah": 82,
      "ayah": 12,
      "verseKey": "82:12",
      "arabic": "يَعْلَمُونَ مَا تَفْعَلُونَ",
      "translationSq": "që dinë gjithçka që bëni."
    },
    {
      "surah": 82,
      "ayah": 13,
      "verseKey": "82:13",
      "arabic": "إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ",
      "translationSq": "Vërtet, punëdrejtët do të jenë në Xhenet,"
    },
    {
      "surah": 82,
      "ayah": 14,
      "verseKey": "82:14",
      "arabic": "وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍ",
      "translationSq": "kurse fajtorët, me siguri, do të jenë në Zjarrin flakërues,"
    },
    {
      "surah": 82,
      "ayah": 15,
      "verseKey": "82:15",
      "arabic": "يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ",
      "translationSq": "në të cilin do të digjen në Ditën e Gjykimit,"
    },
    {
      "surah": 82,
      "ayah": 16,
      "verseKey": "82:16",
      "arabic": "وَمَا هُمْ عَنْهَا بِغَآئِبِينَ",
      "translationSq": "pa mundur t’i shmangen atij."
    },
    {
      "surah": 82,
      "ayah": 17,
      "verseKey": "82:17",
      "arabic": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ",
      "translationSq": "E kush do të ta shpjegojë ty se ç’është Dita e Gjykimit?"
    },
    {
      "surah": 82,
      "ayah": 18,
      "verseKey": "82:18",
      "arabic": "ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ",
      "translationSq": "Edhe njëherë: Kush do të ta shpjegojë ty se ç’është Dita e Gjykimit?"
    },
    {
      "surah": 82,
      "ayah": 19,
      "verseKey": "82:19",
      "arabic": "يَوْمَ لَا تَمْلِكُ نَفْسٌ لِّنَفْسٍ شَيْـًٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍ لِّلَّهِ",
      "translationSq": "Ajo është Dita, kur askush nuk do të ketë fuqi për të bërë gjë për ndonjë tjetër dhe, kur pushteti do të jetë vetëm i Allahut."
    }
  ]
}