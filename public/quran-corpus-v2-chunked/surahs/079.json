{
  "surah": 79,
  "verseCount": 46,
  "verses": [
    {
      "surah": 79,
      "ayah": 1,
      "verseKey": "79:1",
      "arabic": " وَٱلنَّـٰزِعَـٰتِ غَرْقًا",
      "translationSq": "Për ata (engjëj) që marrin me forcë,"
    },
    {
      "surah": 79,
      "ayah": 2,
      "verseKey": "79:2",
      "arabic": "وَٱلنَّـٰشِطَـٰتِ نَشْطًا",
      "translationSq": "për ata që marrin butësisht,"
    },
    {
      "surah": 79,
      "ayah": 3,
      "verseKey": "79:3",
      "arabic": "وَٱلسَّـٰبِحَـٰتِ سَبْحًا",
      "translationSq": "për ata që notojnë në hapësirë,"
    },
    {
      "surah": 79,
      "ayah": 4,
      "verseKey": "79:4",
      "arabic": "فَٱلسَّـٰبِقَـٰتِ سَبْقًا",
      "translationSq": "për ata që nxitojnë,"
    },
    {
      "surah": 79,
      "ayah": 5,
      "verseKey": "79:5",
      "arabic": "فَٱلْمُدَبِّرَٰتِ أَمْرًا",
      "translationSq": "dhe për ata që i rregullojnë punët!"
    },
    {
      "surah": 79,
      "ayah": 6,
      "verseKey": "79:6",
      "arabic": "يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ",
      "translationSq": "Ditën kur do të dridhet gjithçka nga ushtima (që lajmëron Kiametin),"
    },
    {
      "surah": 79,
      "ayah": 7,
      "verseKey": "79:7",
      "arabic": "تَتْبَعُهَا ٱلرَّادِفَةُ",
      "translationSq": "e cila do ta ndiqet nga një e dytë,"
    },
    {
      "surah": 79,
      "ayah": 8,
      "verseKey": "79:8",
      "arabic": "قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ",
      "translationSq": "disa zemra do të jenë të mbushura me tmerr"
    },
    {
      "surah": 79,
      "ayah": 9,
      "verseKey": "79:9",
      "arabic": "أَبْصَـٰرُهَا خَـٰشِعَةٌ",
      "translationSq": "e shikimet e tyre do të bien përdhe."
    },
    {
      "surah": 79,
      "ayah": 10,
      "verseKey": "79:10",
      "arabic": "يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ",
      "translationSq": "Ata thonë: “Vallë, vërtet do të rikthehemi në jetë?!"
    },
    {
      "surah": 79,
      "ayah": 11,
      "verseKey": "79:11",
      "arabic": "أَءِذَا كُنَّا عِظَـٰمًا نَّخِرَةً",
      "translationSq": "A thua, edhe kur të bëhemi eshtra të thërrmuara?!”"
    },
    {
      "surah": 79,
      "ayah": 12,
      "verseKey": "79:12",
      "arabic": "قَالُوا۟ تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ",
      "translationSq": "Dhe thonë: “Po qe kështu, atëherë ky kthim do të jetë humbje (për ne)!”"
    },
    {
      "surah": 79,
      "ayah": 13,
      "verseKey": "79:13",
      "arabic": "فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ",
      "translationSq": "Por, ajo do të jetë veç një fryrje e vetme (e Surit)"
    },
    {
      "surah": 79,
      "ayah": 14,
      "verseKey": "79:14",
      "arabic": "فَإِذَا هُم بِٱلسَّاهِرَةِ",
      "translationSq": "dhe ata përnjëherësh do të brofin (të ringjallur)."
    },
    {
      "surah": 79,
      "ayah": 15,
      "verseKey": "79:15",
      "arabic": "هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ",
      "translationSq": "A e ke dëgjuar (o Muhamed) historinë e Musait?"
    },
    {
      "surah": 79,
      "ayah": 16,
      "verseKey": "79:16",
      "arabic": "إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى",
      "translationSq": "Zoti i tij e thirri në luginën e shenjtë të Tuvas dhe i tha:"
    },
    {
      "surah": 79,
      "ayah": 17,
      "verseKey": "79:17",
      "arabic": "ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ",
      "translationSq": "“Shko te Faraoni, se ai, me të vërtetë, ka kaluar çdo kufi;"
    },
    {
      "surah": 79,
      "ayah": 18,
      "verseKey": "79:18",
      "arabic": "فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ",
      "translationSq": "dhe thuaji: “A do ta pastrosh veten,"
    },
    {
      "surah": 79,
      "ayah": 19,
      "verseKey": "79:19",
      "arabic": "وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ",
      "translationSq": "dhe të të udhëzoj te Zoti yt, që t’i frikësohesh?”"
    },
    {
      "surah": 79,
      "ayah": 20,
      "verseKey": "79:20",
      "arabic": "فَأَرَىٰهُ ٱلْـَٔايَةَ ٱلْكُبْرَىٰ",
      "translationSq": "Musai ia tregoi mrekullinë më të madhe,"
    },
    {
      "surah": 79,
      "ayah": 21,
      "verseKey": "79:21",
      "arabic": "فَكَذَّبَ وَعَصَىٰ",
      "translationSq": "por ai (Faraoni) e mohoi dhe e kundërshtoi."
    },
    {
      "surah": 79,
      "ayah": 22,
      "verseKey": "79:22",
      "arabic": "ثُمَّ أَدْبَرَ يَسْعَىٰ",
      "translationSq": "Pastaj i ktheu shpinën, duke u përpjekur (kundër së vërtetës)"
    },
    {
      "surah": 79,
      "ayah": 23,
      "verseKey": "79:23",
      "arabic": "فَحَشَرَ فَنَادَىٰ",
      "translationSq": "dhe tuboi njerëzit e u deklaroi:"
    },
    {
      "surah": 79,
      "ayah": 24,
      "verseKey": "79:24",
      "arabic": "فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ",
      "translationSq": "“Unë jam zoti juaj më i lartë!”"
    },
    {
      "surah": 79,
      "ayah": 25,
      "verseKey": "79:25",
      "arabic": "فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْـَٔاخِرَةِ وَٱلْأُولَىٰٓ",
      "translationSq": "Prandaj Allahu e goditi atë me dënim në jetën tjetër dhe në këtë jetë."
    },
    {
      "surah": 79,
      "ayah": 26,
      "verseKey": "79:26",
      "arabic": "إِنَّ فِى ذَٰلِكَ لَعِبْرَةً لِّمَن يَخْشَىٰٓ",
      "translationSq": "Kjo është këshillë për ata që i frikësohen Allahut."
    },
    {
      "surah": 79,
      "ayah": 27,
      "verseKey": "79:27",
      "arabic": "ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا",
      "translationSq": "Cili është më i vështirë: krijimi i juaj apo i qiellit, të cilin Ai e ndërtoi,"
    },
    {
      "surah": 79,
      "ayah": 28,
      "verseKey": "79:28",
      "arabic": "رَفَعَ سَمْكَهَا فَسَوَّىٰهَا",
      "translationSq": "ia ngriti lart kupën dhe e përsosi."
    },
    {
      "surah": 79,
      "ayah": 29,
      "verseKey": "79:29",
      "arabic": "وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا",
      "translationSq": "Netët i bëri të errëta, kurse ditët të ndritshme."
    },
    {
      "surah": 79,
      "ayah": 30,
      "verseKey": "79:30",
      "arabic": "وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ",
      "translationSq": "Pastaj e shtriu rrafsh Tokën,"
    },
    {
      "surah": 79,
      "ayah": 31,
      "verseKey": "79:31",
      "arabic": "أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا",
      "translationSq": "dhe, nga ajo nxori ujërat dhe bëri kullotat,"
    },
    {
      "surah": 79,
      "ayah": 32,
      "verseKey": "79:32",
      "arabic": "وَٱلْجِبَالَ أَرْسَىٰهَا",
      "translationSq": "kurse malet i bëri të patundshme,"
    },
    {
      "surah": 79,
      "ayah": 33,
      "verseKey": "79:33",
      "arabic": "مَتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ",
      "translationSq": "që t’i gëzoni ju dhe bagëtitë tuaja."
    },
    {
      "surah": 79,
      "ayah": 34,
      "verseKey": "79:34",
      "arabic": "فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ",
      "translationSq": "Kur të arrijë gjëma më e madhe,"
    },
    {
      "surah": 79,
      "ayah": 35,
      "verseKey": "79:35",
      "arabic": "يَوْمَ يَتَذَكَّرُ ٱلْإِنسَـٰنُ مَا سَعَىٰ",
      "translationSq": "atë Ditë njeriu do të kujtojë gjithçka që ka bërë"
    },
    {
      "surah": 79,
      "ayah": 36,
      "verseKey": "79:36",
      "arabic": "وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ",
      "translationSq": "dhe Zjarri flakërues do t’i tregohet çdokujt që sheh."
    },
    {
      "surah": 79,
      "ayah": 37,
      "verseKey": "79:37",
      "arabic": "فَأَمَّا مَن طَغَىٰ",
      "translationSq": "Atëherë, ai që ka shkelur gjithçka"
    },
    {
      "surah": 79,
      "ayah": 38,
      "verseKey": "79:38",
      "arabic": "وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا",
      "translationSq": "dhe ka parapëlqyer jetën e kësaj bote,"
    },
    {
      "surah": 79,
      "ayah": 39,
      "verseKey": "79:39",
      "arabic": "فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ",
      "translationSq": "sigurisht që do të ketë për strehë Xhehenemin."
    },
    {
      "surah": 79,
      "ayah": 40,
      "verseKey": "79:40",
      "arabic": "وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ",
      "translationSq": "Kurse ai që i është frikësuar madhërisë së Zotit të tij dhe e ka frenuar veten nga dëshirat,"
    },
    {
      "surah": 79,
      "ayah": 41,
      "verseKey": "79:41",
      "arabic": "فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ",
      "translationSq": "pa dyshim që do të ketë për strehë Xhenetin."
    },
    {
      "surah": 79,
      "ayah": 42,
      "verseKey": "79:42",
      "arabic": "يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا",
      "translationSq": "Të pyesin ty për Orën (e Kiametit) se kur do të ndodhë."
    },
    {
      "surah": 79,
      "ayah": 43,
      "verseKey": "79:43",
      "arabic": "فِيمَ أَنتَ مِن ذِكْرَىٰهَآ",
      "translationSq": "Çfarë rëndësie ka për ty që ta përmendësh atë?"
    },
    {
      "surah": 79,
      "ayah": 44,
      "verseKey": "79:44",
      "arabic": "إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ",
      "translationSq": "Tek Zoti yt është fundi i (dijenisë rreth) saj."
    },
    {
      "surah": 79,
      "ayah": 45,
      "verseKey": "79:45",
      "arabic": "إِنَّمَآ أَنتَ مُنذِرُ مَن يَخْشَىٰهَا",
      "translationSq": "Ti je vetëm paralajmërues i atyre që i frikësohen asaj."
    },
    {
      "surah": 79,
      "ayah": 46,
      "verseKey": "79:46",
      "arabic": "كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓا۟ إِلَّا عَشِيَّةً أَوْ ضُحَىٰهَا",
      "translationSq": "Ditën kur do ta shohin atë, (njerëzve) do t’u duket se kanë qëndruar (në Tokë) veç një mbrëmje apo një mëngjes."
    }
  ]
}