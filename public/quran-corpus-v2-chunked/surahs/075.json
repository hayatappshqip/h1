{
  "surah": 75,
  "verseCount": 40,
  "verses": [
    {
      "surah": 75,
      "ayah": 1,
      "verseKey": "75:1",
      "arabic": " لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَـٰمَةِ",
      "translationSq": "Betohem në Ditën e Kiametit!"
    },
    {
      "surah": 75,
      "ayah": 2,
      "verseKey": "75:2",
      "arabic": "وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ",
      "translationSq": "Betohem në shpirtin qortues!"
    },
    {
      "surah": 75,
      "ayah": 3,
      "verseKey": "75:3",
      "arabic": "أَيَحْسَبُ ٱلْإِنسَـٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ",
      "translationSq": "A mendon njeriu se nuk do të mund t’i mbledhim eshtrat e tij?!"
    },
    {
      "surah": 75,
      "ayah": 4,
      "verseKey": "75:4",
      "arabic": "بَلَىٰ قَـٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ",
      "translationSq": "Po, si jo! Ne jemi të Zotë t’ia ribëjmë bashkë me përsosmëri edhe majat e gishtave të tij."
    },
    {
      "surah": 75,
      "ayah": 5,
      "verseKey": "75:5",
      "arabic": "بَلْ يُرِيدُ ٱلْإِنسَـٰنُ لِيَفْجُرَ أَمَامَهُۥ",
      "translationSq": "Por njeriu dëshiron të gabojë sa të jetë gjallë"
    },
    {
      "surah": 75,
      "ayah": 6,
      "verseKey": "75:6",
      "arabic": "يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَـٰمَةِ",
      "translationSq": "dhe pyet: “Kur do të jetë Dita e Kiametit?”"
    },
    {
      "surah": 75,
      "ayah": 7,
      "verseKey": "75:7",
      "arabic": "فَإِذَا بَرِقَ ٱلْبَصَرُ",
      "translationSq": "Por, kur sytë t’i verbohen"
    },
    {
      "surah": 75,
      "ayah": 8,
      "verseKey": "75:8",
      "arabic": "وَخَسَفَ ٱلْقَمَرُ",
      "translationSq": "dhe të zihet Hëna"
    },
    {
      "surah": 75,
      "ayah": 9,
      "verseKey": "75:9",
      "arabic": "وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ",
      "translationSq": "dhe Dielli e Hëna të bashkohen,"
    },
    {
      "surah": 75,
      "ayah": 10,
      "verseKey": "75:10",
      "arabic": "يَقُولُ ٱلْإِنسَـٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ",
      "translationSq": "atë ditë njeriu do të thotë: “Ku të iki?”"
    },
    {
      "surah": 75,
      "ayah": 11,
      "verseKey": "75:11",
      "arabic": "كَلَّا لَا وَزَرَ",
      "translationSq": "Askund! S’ka strehë!"
    },
    {
      "surah": 75,
      "ayah": 12,
      "verseKey": "75:12",
      "arabic": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ",
      "translationSq": "Atë ditë, streha është te Zoti yt."
    },
    {
      "surah": 75,
      "ayah": 13,
      "verseKey": "75:13",
      "arabic": "يُنَبَّؤُا۟ ٱلْإِنسَـٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ",
      "translationSq": "Atë ditë, njeriu do të vihet në dijeni për veprat që ka bërë dhe për ato që ka lënë pa bërë."
    },
    {
      "surah": 75,
      "ayah": 14,
      "verseKey": "75:14",
      "arabic": "بَلِ ٱلْإِنسَـٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌ",
      "translationSq": "Po, vërtet që njeriu do të dëshmojë kundër vetvetes,"
    },
    {
      "surah": 75,
      "ayah": 15,
      "verseKey": "75:15",
      "arabic": "وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ",
      "translationSq": "edhe sikur të paraqesë shfajësimet e veta."
    },
    {
      "surah": 75,
      "ayah": 16,
      "verseKey": "75:16",
      "arabic": "لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ",
      "translationSq": "Mos nxito (o Muhamed) në leximin e Kuranit me gjuhën tënde!"
    },
    {
      "surah": 75,
      "ayah": 17,
      "verseKey": "75:17",
      "arabic": "إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ",
      "translationSq": "Ne e kemi për detyrë t’i mbledhim pjesët e tij e ta lexojmë atë."
    },
    {
      "surah": 75,
      "ayah": 18,
      "verseKey": "75:18",
      "arabic": "فَإِذَا قَرَأْنَـٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ",
      "translationSq": "Dhe, kur ta lexojmë atë, ti përcille leximin e tij!"
    },
    {
      "surah": 75,
      "ayah": 19,
      "verseKey": "75:19",
      "arabic": "ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ",
      "translationSq": "Pastaj, e kemi Ne për detyrë ta shpjegojmë."
    },
    {
      "surah": 75,
      "ayah": 20,
      "verseKey": "75:20",
      "arabic": "كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ",
      "translationSq": "Por ju doni këtë jetë (kalimtare)"
    },
    {
      "surah": 75,
      "ayah": 21,
      "verseKey": "75:21",
      "arabic": "وَتَذَرُونَ ٱلْـَٔاخِرَةَ",
      "translationSq": "e për jetën tjetër nuk kujtoheni!"
    },
    {
      "surah": 75,
      "ayah": 22,
      "verseKey": "75:22",
      "arabic": "وُجُوهٌ يَوْمَئِذٍ نَّاضِرَةٌ",
      "translationSq": "Atë ditë, disa fytyra do të shkëlqejnë"
    },
    {
      "surah": 75,
      "ayah": 23,
      "verseKey": "75:23",
      "arabic": "إِلَىٰ رَبِّهَا نَاظِرَةٌ",
      "translationSq": "dhe Zotin e tyre do të shohin."
    },
    {
      "surah": 75,
      "ayah": 24,
      "verseKey": "75:24",
      "arabic": "وَوُجُوهٌ يَوْمَئِذٍۭ بَاسِرَةٌ",
      "translationSq": "Kurse disa fytyra, atë ditë, do të jenë të zymta,"
    },
    {
      "surah": 75,
      "ayah": 25,
      "verseKey": "75:25",
      "arabic": "تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌ",
      "translationSq": "duke e ditur se do të pësojnë një fatkeqësi, që të thyen në mes."
    },
    {
      "surah": 75,
      "ayah": 26,
      "verseKey": "75:26",
      "arabic": "كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ",
      "translationSq": "Por, kur shpirti të vijë në grykë"
    },
    {
      "surah": 75,
      "ayah": 27,
      "verseKey": "75:27",
      "arabic": "وَقِيلَ مَنْ ۜ رَاقٍ",
      "translationSq": "e të thërrasin “A ka shërues”,"
    },
    {
      "surah": 75,
      "ayah": 28,
      "verseKey": "75:28",
      "arabic": "وَظَنَّ أَنَّهُ ٱلْفِرَاقُ",
      "translationSq": "atëherë, ai (që po vdes) do të bindet se ky është çasti i ndarjes"
    },
    {
      "surah": 75,
      "ayah": 29,
      "verseKey": "75:29",
      "arabic": "وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ",
      "translationSq": "dhe këmbët do të ngrijnë."
    },
    {
      "surah": 75,
      "ayah": 30,
      "verseKey": "75:30",
      "arabic": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ",
      "translationSq": "Atë ditë, ai do të sillet te Zoti yt."
    },
    {
      "surah": 75,
      "ayah": 31,
      "verseKey": "75:31",
      "arabic": "فَلَا صَدَّقَ وَلَا صَلَّىٰ",
      "translationSq": "Ai as nuk besoi dhe as nuk u fal,"
    },
    {
      "surah": 75,
      "ayah": 32,
      "verseKey": "75:32",
      "arabic": "وَلَـٰكِن كَذَّبَ وَتَوَلَّىٰ",
      "translationSq": "por e mohoi të vërtetën dhe ia ktheu kurrizin,"
    },
    {
      "surah": 75,
      "ayah": 33,
      "verseKey": "75:33",
      "arabic": "ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ",
      "translationSq": "e pastaj shkoi te njerëzit e vet, duke u krenuar."
    },
    {
      "surah": 75,
      "ayah": 34,
      "verseKey": "75:34",
      "arabic": "أَوْلَىٰ لَكَ فَأَوْلَىٰ",
      "translationSq": "Mjerë për ty! Mjerë për ty!"
    },
    {
      "surah": 75,
      "ayah": 35,
      "verseKey": "75:35",
      "arabic": "ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ",
      "translationSq": "Sërish: Mjerë për ty! Mjerë për ty!"
    },
    {
      "surah": 75,
      "ayah": 36,
      "verseKey": "75:36",
      "arabic": "أَيَحْسَبُ ٱلْإِنسَـٰنُ أَن يُتْرَكَ سُدًى",
      "translationSq": "Vallë, a mendon njeriu se do të mbetet pa përgjegjshmëri?"
    },
    {
      "surah": 75,
      "ayah": 37,
      "verseKey": "75:37",
      "arabic": "أَلَمْ يَكُ نُطْفَةً مِّن مَّنِىٍّ يُمْنَىٰ",
      "translationSq": "A s’ka qenë një pikë fare që derdhej,"
    },
    {
      "surah": 75,
      "ayah": 38,
      "verseKey": "75:38",
      "arabic": "ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوَّىٰ",
      "translationSq": "pastaj u bë droçkë gjaku e më pas Allahu e krijoi dhe i dha formë e përmasa të caktuara,"
    },
    {
      "surah": 75,
      "ayah": 39,
      "verseKey": "75:39",
      "arabic": "فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ",
      "translationSq": "e prej tij bëri çiftin: mashkullin e femrën?!"
    },
    {
      "surah": 75,
      "ayah": 40,
      "verseKey": "75:40",
      "arabic": "أَلَيْسَ ذَٰلِكَ بِقَـٰدِرٍ عَلَىٰٓ أَن يُحْـِۧىَ ٱلْمَوْتَىٰ",
      "translationSq": "Vallë, Ai Krijues, a nuk ka fuqi që t’i ngjallë të vdekurit?!"
    }
  ]
}