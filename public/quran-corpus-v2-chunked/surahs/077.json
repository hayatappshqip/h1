{
  "surah": 77,
  "verseCount": 50,
  "verses": [
    {
      "surah": 77,
      "ayah": 1,
      "verseKey": "77:1",
      "arabic": " وَٱلْمُرْسَلَـٰتِ عُرْفًا",
      "translationSq": "Për ato që dërgohen njëra pas tjetrës,"
    },
    {
      "surah": 77,
      "ayah": 2,
      "verseKey": "77:2",
      "arabic": "فَٱلْعَـٰصِفَـٰتِ عَصْفًا",
      "translationSq": "për ato që shpejtojnë shtrëngatën,"
    },
    {
      "surah": 77,
      "ayah": 3,
      "verseKey": "77:3",
      "arabic": "وَٱلنَّـٰشِرَٰتِ نَشْرًا",
      "translationSq": "për ato që shpërndajnë shiun,"
    },
    {
      "surah": 77,
      "ayah": 4,
      "verseKey": "77:4",
      "arabic": "فَٱلْفَـٰرِقَـٰتِ فَرْقًا",
      "translationSq": "për ato që ndajnë saktësisht"
    },
    {
      "surah": 77,
      "ayah": 5,
      "verseKey": "77:5",
      "arabic": "فَٱلْمُلْقِيَـٰتِ ذِكْرًا",
      "translationSq": "dhe për ato që përcjellin këshilla,"
    },
    {
      "surah": 77,
      "ayah": 6,
      "verseKey": "77:6",
      "arabic": "عُذْرًا أَوْ نُذْرًا",
      "translationSq": "si shfajësim apo paralajmërim!"
    },
    {
      "surah": 77,
      "ayah": 7,
      "verseKey": "77:7",
      "arabic": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٌ",
      "translationSq": "Në të vërtetë, ajo që ju është premtuar, do të bëhet!"
    },
    {
      "surah": 77,
      "ayah": 8,
      "verseKey": "77:8",
      "arabic": "فَإِذَا ٱلنُّجُومُ طُمِسَتْ",
      "translationSq": "Kur yjet të shuhen"
    },
    {
      "surah": 77,
      "ayah": 9,
      "verseKey": "77:9",
      "arabic": "وَإِذَا ٱلسَّمَآءُ فُرِجَتْ",
      "translationSq": "dhe, kur qielli të çahet"
    },
    {
      "surah": 77,
      "ayah": 10,
      "verseKey": "77:10",
      "arabic": "وَإِذَا ٱلْجِبَالُ نُسِفَتْ",
      "translationSq": "dhe, kur malet të thërrmohen si pluhur"
    },
    {
      "surah": 77,
      "ayah": 11,
      "verseKey": "77:11",
      "arabic": "وَإِذَا ٱلرُّسُلُ أُقِّتَتْ",
      "translationSq": "dhe, kur të dërguarit të tubohen në kohën e caktuar"
    },
    {
      "surah": 77,
      "ayah": 12,
      "verseKey": "77:12",
      "arabic": "لِأَىِّ يَوْمٍ أُجِّلَتْ",
      "translationSq": "- në cilën ditë do të ndodhin të gjitha këto?"
    },
    {
      "surah": 77,
      "ayah": 13,
      "verseKey": "77:13",
      "arabic": "لِيَوْمِ ٱلْفَصْلِ",
      "translationSq": "Në Ditën e Ndarjes vendimtare!"
    },
    {
      "surah": 77,
      "ayah": 14,
      "verseKey": "77:14",
      "arabic": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ",
      "translationSq": "Kush vallë do të ta shpjegojë se ç’është Dita e Ndarjes vendimtare?"
    },
    {
      "surah": 77,
      "ayah": 15,
      "verseKey": "77:15",
      "arabic": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "translationSq": "Mjerë mohuesit në atë ditë!"
    },
    {
      "surah": 77,
      "ayah": 16,
      "verseKey": "77:16",
      "arabic": "أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ",
      "translationSq": "A nuk i kemi zhdukur të lashtët"
    },
    {
      "surah": 77,
      "ayah": 17,
      "verseKey": "77:17",
      "arabic": "ثُمَّ نُتْبِعُهُمُ ٱلْـَٔاخِرِينَ",
      "translationSq": "e pastaj do t’i bëjmë të tjerët t’i pasojnë?"
    },
    {
      "surah": 77,
      "ayah": 18,
      "verseKey": "77:18",
      "arabic": "كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ",
      "translationSq": "Kështu do të veprojmë me të gjithë keqbërësit!"
    },
    {
      "surah": 77,
      "ayah": 19,
      "verseKey": "77:19",
      "arabic": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "translationSq": "Mjerë mohuesit në atë ditë!"
    },
    {
      "surah": 77,
      "ayah": 20,
      "verseKey": "77:20",
      "arabic": "أَلَمْ نَخْلُقكُّم مِّن مَّآءٍ مَّهِينٍ",
      "translationSq": "A nuk ju kemi krijuar nga një pikë lëngu të shpërfillur,"
    },
    {
      "surah": 77,
      "ayah": 21,
      "verseKey": "77:21",
      "arabic": "فَجَعَلْنَـٰهُ فِى قَرَارٍ مَّكِينٍ",
      "translationSq": "të cilën e vumë në një vend të sigurt (mitër),"
    },
    {
      "surah": 77,
      "ayah": 22,
      "verseKey": "77:22",
      "arabic": "إِلَىٰ قَدَرٍ مَّعْلُومٍ",
      "translationSq": "deri në një kohë të caktuar?!"
    },
    {
      "surah": 77,
      "ayah": 23,
      "verseKey": "77:23",
      "arabic": "فَقَدَرْنَا فَنِعْمَ ٱلْقَـٰدِرُونَ",
      "translationSq": "Kështu e kemi rregulluar; sa Rregullues të shkëlqyer jemi Ne!"
    },
    {
      "surah": 77,
      "ayah": 24,
      "verseKey": "77:24",
      "arabic": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "translationSq": "Mjerë mohuesit në atë ditë!"
    },
    {
      "surah": 77,
      "ayah": 25,
      "verseKey": "77:25",
      "arabic": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا",
      "translationSq": "A nuk e kemi bërë Tokën vendqëndrim"
    },
    {
      "surah": 77,
      "ayah": 26,
      "verseKey": "77:26",
      "arabic": "أَحْيَآءً وَأَمْوَٰتًا",
      "translationSq": "të të gjallëve dhe të të vdekurve?"
    },
    {
      "surah": 77,
      "ayah": 27,
      "verseKey": "77:27",
      "arabic": "وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَـٰمِخَـٰتٍ وَأَسْقَيْنَـٰكُم مَّآءً فُرَاتًا",
      "translationSq": "A nuk kemi vënë në të male të larta e të patundshme? A nuk ju kemi dhënë të pini me bollëk ujë të ëmbël?"
    },
    {
      "surah": 77,
      "ayah": 28,
      "verseKey": "77:28",
      "arabic": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "translationSq": "Mjerë mohuesit në atë ditë!"
    },
    {
      "surah": 77,
      "ayah": 29,
      "verseKey": "77:29",
      "arabic": "ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ",
      "translationSq": "(Do t’u thuhet): Nisuni drejt atij (dënimi) që e mohuat!"
    },
    {
      "surah": 77,
      "ayah": 30,
      "verseKey": "77:30",
      "arabic": "ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّ ذِى ثَلَـٰثِ شُعَبٍ",
      "translationSq": "Shkoni drejt një hijeje me tri kolona (tymi të Xhehenemit),"
    },
    {
      "surah": 77,
      "ayah": 31,
      "verseKey": "77:31",
      "arabic": "لَّا ظَلِيلٍ وَلَا يُغْنِى مِنَ ٱللَّهَبِ",
      "translationSq": "e cila nuk bën hije (freskuese) dhe as nga flaka nuk të shpëton!"
    },
    {
      "surah": 77,
      "ayah": 32,
      "verseKey": "77:32",
      "arabic": "إِنَّهَا تَرْمِى بِشَرَرٍ كَٱلْقَصْرِ",
      "translationSq": "Ajo hedh shkëndija të mëdha sa një kala,"
    },
    {
      "surah": 77,
      "ayah": 33,
      "verseKey": "77:33",
      "arabic": "كَأَنَّهُۥ جِمَـٰلَتٌ صُفْرٌ",
      "translationSq": "sikur të ishin deve të verdha!"
    },
    {
      "surah": 77,
      "ayah": 34,
      "verseKey": "77:34",
      "arabic": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "translationSq": "Mjerë mohuesit në atë ditë!"
    },
    {
      "surah": 77,
      "ayah": 35,
      "verseKey": "77:35",
      "arabic": "هَـٰذَا يَوْمُ لَا يَنطِقُونَ",
      "translationSq": "Kjo është një ditë, kur ata nuk do të mund të flasin"
    },
    {
      "surah": 77,
      "ayah": 36,
      "verseKey": "77:36",
      "arabic": "وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ",
      "translationSq": "dhe nuk do t’u jepet leje për t’u shfajësuar."
    },
    {
      "surah": 77,
      "ayah": 37,
      "verseKey": "77:37",
      "arabic": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "translationSq": "Mjerë mohuesit në atë ditë!"
    },
    {
      "surah": 77,
      "ayah": 38,
      "verseKey": "77:38",
      "arabic": "هَـٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَـٰكُمْ وَٱلْأَوَّلِينَ",
      "translationSq": "Kjo është Dita e Ndarjes vendimtare, në të cilën do të tuboheni ju dhe popujt e lashtë,"
    },
    {
      "surah": 77,
      "ayah": 39,
      "verseKey": "77:39",
      "arabic": "فَإِن كَانَ لَكُمْ كَيْدٌ فَكِيدُونِ",
      "translationSq": "prandaj, nëse zotëroni ndonjë dinakëri, përdoreni kundër Meje!"
    },
    {
      "surah": 77,
      "ayah": 40,
      "verseKey": "77:40",
      "arabic": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "translationSq": "Mjerë mohuesit në atë ditë!"
    },
    {
      "surah": 77,
      "ayah": 41,
      "verseKey": "77:41",
      "arabic": "إِنَّ ٱلْمُتَّقِينَ فِى ظِلَـٰلٍ وَعُيُونٍ",
      "translationSq": "Punëdrejtët do të jenë mes hijesh e burimesh,"
    },
    {
      "surah": 77,
      "ayah": 42,
      "verseKey": "77:42",
      "arabic": "وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ",
      "translationSq": "si dhe frutash nga ato që dëshirojnë."
    },
    {
      "surah": 77,
      "ayah": 43,
      "verseKey": "77:43",
      "arabic": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ",
      "translationSq": "(Do t’u thuhet) “Hani e pini e ju bëftë mirë, (si shpërblim) për atë që keni punuar.”"
    },
    {
      "surah": 77,
      "ayah": 44,
      "verseKey": "77:44",
      "arabic": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ",
      "translationSq": "Kështu i shpërblejmë Ne ata, që bëjnë vepra të mira."
    },
    {
      "surah": 77,
      "ayah": 45,
      "verseKey": "77:45",
      "arabic": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "translationSq": "Mjerë mohuesit në atë ditë!"
    },
    {
      "surah": 77,
      "ayah": 46,
      "verseKey": "77:46",
      "arabic": "كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ",
      "translationSq": "Hani dhe kënaquni për pak kohë! Ju jeni keqbërës!"
    },
    {
      "surah": 77,
      "ayah": 47,
      "verseKey": "77:47",
      "arabic": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "translationSq": "Mjerë mohuesit në atë ditë!"
    },
    {
      "surah": 77,
      "ayah": 48,
      "verseKey": "77:48",
      "arabic": "وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ",
      "translationSq": "Kur atyre u thuhej: “Përkuluni (në namaz para Allahut)!” ata nuk përkuleshin."
    },
    {
      "surah": 77,
      "ayah": 49,
      "verseKey": "77:49",
      "arabic": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "translationSq": "Mjerë mohuesit në atë ditë!"
    },
    {
      "surah": 77,
      "ayah": 50,
      "verseKey": "77:50",
      "arabic": "فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ",
      "translationSq": "Në çfarë shpallje tjetër do të besojnë ata, pas këtij (Kurani)?!"
    }
  ]
}