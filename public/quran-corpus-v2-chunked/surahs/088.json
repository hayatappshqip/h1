{
  "surah": 88,
  "verseCount": 26,
  "verses": [
    {
      "surah": 88,
      "ayah": 1,
      "verseKey": "88:1",
      "arabic": " هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَـٰشِيَةِ",
      "translationSq": "A ke dëgjuar për Ngjarjen Gjithëpërfshirëse (Kiametin)?"
    },
    {
      "surah": 88,
      "ayah": 2,
      "verseKey": "88:2",
      "arabic": "وُجُوهٌ يَوْمَئِذٍ خَـٰشِعَةٌ",
      "translationSq": "Atë Ditë do të poshtërohen fytyra njerëzish,"
    },
    {
      "surah": 88,
      "ayah": 3,
      "verseKey": "88:3",
      "arabic": "عَامِلَةٌ نَّاصِبَةٌ",
      "translationSq": "që kanë punuar e janë rraskapitur (duke bërë të këqija në këtë botë)."
    },
    {
      "surah": 88,
      "ayah": 4,
      "verseKey": "88:4",
      "arabic": "تَصْلَىٰ نَارًا حَامِيَةً",
      "translationSq": "Ata do të digjen në zjarr të nxehtë"
    },
    {
      "surah": 88,
      "ayah": 5,
      "verseKey": "88:5",
      "arabic": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ",
      "translationSq": "e do të pinë nga burime të valuara."
    },
    {
      "surah": 88,
      "ayah": 6,
      "verseKey": "88:6",
      "arabic": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ",
      "translationSq": "Për ata nuk do të ketë tjetër ushqim, përveç ferrave helmuese,"
    },
    {
      "surah": 88,
      "ayah": 7,
      "verseKey": "88:7",
      "arabic": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍ",
      "translationSq": "të cilat as nuk do t’i mbajnë, as nuk do t’ua shuajnë urinë."
    },
    {
      "surah": 88,
      "ayah": 8,
      "verseKey": "88:8",
      "arabic": "وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ",
      "translationSq": "Atë Ditë, fytyrat e disave do të jenë të gëzuara,"
    },
    {
      "surah": 88,
      "ayah": 9,
      "verseKey": "88:9",
      "arabic": "لِّسَعْيِهَا رَاضِيَةٌ",
      "translationSq": "të kënaqura për punët e bëra."
    },
    {
      "surah": 88,
      "ayah": 10,
      "verseKey": "88:10",
      "arabic": "فِى جَنَّةٍ عَالِيَةٍ",
      "translationSq": "Ata do të jenë në kopshtin e lartë,"
    },
    {
      "surah": 88,
      "ayah": 11,
      "verseKey": "88:11",
      "arabic": "لَّا تَسْمَعُ فِيهَا لَـٰغِيَةً",
      "translationSq": "në të cilin nuk do të dëgjojnë fjalë boshe."
    },
    {
      "surah": 88,
      "ayah": 12,
      "verseKey": "88:12",
      "arabic": "فِيهَا عَيْنٌ جَارِيَةٌ",
      "translationSq": "Atje ka një burim rrjedhës uji"
    },
    {
      "surah": 88,
      "ayah": 13,
      "verseKey": "88:13",
      "arabic": "فِيهَا سُرُرٌ مَّرْفُوعَةٌ",
      "translationSq": "dhe divane të ngritura,"
    },
    {
      "surah": 88,
      "ayah": 14,
      "verseKey": "88:14",
      "arabic": "وَأَكْوَابٌ مَّوْضُوعَةٌ",
      "translationSq": "ka kupa të vëna (për t’u mbajtur në dorë)"
    },
    {
      "surah": 88,
      "ayah": 15,
      "verseKey": "88:15",
      "arabic": "وَنَمَارِقُ مَصْفُوفَةٌ",
      "translationSq": "dhe jastëkë të renditur,"
    },
    {
      "surah": 88,
      "ayah": 16,
      "verseKey": "88:16",
      "arabic": "وَزَرَابِىُّ مَبْثُوثَةٌ",
      "translationSq": "si dhe shumë qilima të shtruar."
    },
    {
      "surah": 88,
      "ayah": 17,
      "verseKey": "88:17",
      "arabic": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ",
      "translationSq": "Vallë, a nuk i shohin devetë, se si janë krijuar?!"
    },
    {
      "surah": 88,
      "ayah": 18,
      "verseKey": "88:18",
      "arabic": "وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ",
      "translationSq": "Po qiellin, se si është ngritur?!"
    },
    {
      "surah": 88,
      "ayah": 19,
      "verseKey": "88:19",
      "arabic": "وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ",
      "translationSq": "Po malet, se si janë vënë të patundur?!"
    },
    {
      "surah": 88,
      "ayah": 20,
      "verseKey": "88:20",
      "arabic": "وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ",
      "translationSq": "Po Tokën, se si është shtrirë?!"
    },
    {
      "surah": 88,
      "ayah": 21,
      "verseKey": "88:21",
      "arabic": "فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌ",
      "translationSq": "Prandaj këshilloji (njerëzit o Muhamed), se ti je vetëm këshillues"
    },
    {
      "surah": 88,
      "ayah": 22,
      "verseKey": "88:22",
      "arabic": "لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ",
      "translationSq": "dhe nuk je ngarkuar t’i detyrosh ata me forcë!"
    },
    {
      "surah": 88,
      "ayah": 23,
      "verseKey": "88:23",
      "arabic": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ",
      "translationSq": "Sa për ata që shmangen dhe nuk besojnë,"
    },
    {
      "surah": 88,
      "ayah": 24,
      "verseKey": "88:24",
      "arabic": "فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ",
      "translationSq": "Allahu do t’i ndëshkojë me dënimin më të madh."
    },
    {
      "surah": 88,
      "ayah": 25,
      "verseKey": "88:25",
      "arabic": "إِنَّ إِلَيْنَآ إِيَابَهُمْ",
      "translationSq": "Pa dyshim, ata do të kthehen të gjithë tek Ne"
    },
    {
      "surah": 88,
      "ayah": 26,
      "verseKey": "88:26",
      "arabic": "ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم",
      "translationSq": "dhe patjetër që do të japin llogari para Nesh!"
    }
  ]
}