{
  "surah": 56,
  "verseCount": 96,
  "verses": [
    {
      "surah": 56,
      "ayah": 1,
      "verseKey": "56:1",
      "arabic": " إِذَا وَقَعَتِ ٱلْوَاقِعَةُ",
      "translationSq": "Kur të ndodhë Ngjarja (Kiameti),"
    },
    {
      "surah": 56,
      "ayah": 2,
      "verseKey": "56:2",
      "arabic": "لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ",
      "translationSq": "ardhjen e saj askush nuk do ta mohojë."
    },
    {
      "surah": 56,
      "ayah": 3,
      "verseKey": "56:3",
      "arabic": "خَافِضَةٌ رَّافِعَةٌ",
      "translationSq": "Disa do t’i ulë e disa do t’i lartësojë."
    },
    {
      "surah": 56,
      "ayah": 4,
      "verseKey": "56:4",
      "arabic": "إِذَا رُجَّتِ ٱلْأَرْضُ رَجًّا",
      "translationSq": "Kur Toka të dridhet fuqishëm,"
    },
    {
      "surah": 56,
      "ayah": 5,
      "verseKey": "56:5",
      "arabic": "وَبُسَّتِ ٱلْجِبَالُ بَسًّا",
      "translationSq": "malet të thërrmohen copë-copë"
    },
    {
      "surah": 56,
      "ayah": 6,
      "verseKey": "56:6",
      "arabic": "فَكَانَتْ هَبَآءً مُّنۢبَثًّا",
      "translationSq": "e të shndërrohen në pluhur të shpërndarë,"
    },
    {
      "surah": 56,
      "ayah": 7,
      "verseKey": "56:7",
      "arabic": "وَكُنتُمْ أَزْوَٰجًا ثَلَـٰثَةً",
      "translationSq": "ju, (o njerëz) do të ndaheni në tri grupe:"
    },
    {
      "surah": 56,
      "ayah": 8,
      "verseKey": "56:8",
      "arabic": "فَأَصْحَـٰبُ ٱلْمَيْمَنَةِ مَآ أَصْحَـٰبُ ٱلْمَيْمَنَةِ",
      "translationSq": "njerëzit e së djathtës - sa të nderuar do të jenë fatlumët!"
    },
    {
      "surah": 56,
      "ayah": 9,
      "verseKey": "56:9",
      "arabic": "وَأَصْحَـٰبُ ٱلْمَشْـَٔمَةِ مَآ أَصْحَـٰبُ ٱلْمَشْـَٔمَةِ",
      "translationSq": "njerëzit e së majtës - sa të poshtëruar do të jenë fatkeqët!"
    },
    {
      "surah": 56,
      "ayah": 10,
      "verseKey": "56:10",
      "arabic": "وَٱلسَّـٰبِقُونَ ٱلسَّـٰبِقُونَ",
      "translationSq": "dhe ata që kanë prirë (në besim) e që do të prijnë (edhe në Xhenet)."
    },
    {
      "surah": 56,
      "ayah": 11,
      "verseKey": "56:11",
      "arabic": "أُو۟لَـٰٓئِكَ ٱلْمُقَرَّبُونَ",
      "translationSq": "Ata janë të afërtit (tek Allahu),"
    },
    {
      "surah": 56,
      "ayah": 12,
      "verseKey": "56:12",
      "arabic": "فِى جَنَّـٰتِ ٱلنَّعِيمِ",
      "translationSq": "në kopshtet e kënaqësisë."
    },
    {
      "surah": 56,
      "ayah": 13,
      "verseKey": "56:13",
      "arabic": "ثُلَّةٌ مِّنَ ٱلْأَوَّلِينَ",
      "translationSq": "Shumica e tyre janë prej të lashtëve,"
    },
    {
      "surah": 56,
      "ayah": 14,
      "verseKey": "56:14",
      "arabic": "وَقَلِيلٌ مِّنَ ٱلْـَٔاخِرِينَ",
      "translationSq": "ndërsa një pakicë prej brezave të mëvonshëm."
    },
    {
      "surah": 56,
      "ayah": 15,
      "verseKey": "56:15",
      "arabic": "عَلَىٰ سُرُرٍ مَّوْضُونَةٍ",
      "translationSq": "Ata do të qëndrojnë në divane të stolisura me ar e gurë të çmuar,"
    },
    {
      "surah": 56,
      "ayah": 16,
      "verseKey": "56:16",
      "arabic": "مُّتَّكِـِٔينَ عَلَيْهَا مُتَقَـٰبِلِينَ",
      "translationSq": "të mbështetur në to përballë njëri-tjetrit."
    },
    {
      "surah": 56,
      "ayah": 17,
      "verseKey": "56:17",
      "arabic": "يَطُوفُ عَلَيْهِمْ وِلْدَٰنٌ مُّخَلَّدُونَ",
      "translationSq": "Do t’u sillen rreth (për shërbim) djelmosha përherë të rinj,"
    },
    {
      "surah": 56,
      "ayah": 18,
      "verseKey": "56:18",
      "arabic": "بِأَكْوَابٍ وَأَبَارِيقَ وَكَأْسٍ مِّن مَّعِينٍ",
      "translationSq": "me kupa, ibrikë dhe gota me pije të kulluar, që rrjedh"
    },
    {
      "surah": 56,
      "ayah": 19,
      "verseKey": "56:19",
      "arabic": "لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزِفُونَ",
      "translationSq": "e prej së cilës nuk do t’u dhembë koka dhe nuk do t’u humbë mendja,"
    },
    {
      "surah": 56,
      "ayah": 20,
      "verseKey": "56:20",
      "arabic": "وَفَـٰكِهَةٍ مِّمَّا يَتَخَيَّرُونَ",
      "translationSq": "e me fruta të cilat do t’i zgjedhin vetë"
    },
    {
      "surah": 56,
      "ayah": 21,
      "verseKey": "56:21",
      "arabic": "وَلَحْمِ طَيْرٍ مِّمَّا يَشْتَهُونَ",
      "translationSq": "dhe mish shpendësh që ua ka ënda."
    },
    {
      "surah": 56,
      "ayah": 22,
      "verseKey": "56:22",
      "arabic": "وَحُورٌ عِينٌ",
      "translationSq": "Për ata ka edhe hyri symëdha,"
    },
    {
      "surah": 56,
      "ayah": 23,
      "verseKey": "56:23",
      "arabic": "كَأَمْثَـٰلِ ٱللُّؤْلُؤِ ٱلْمَكْنُونِ",
      "translationSq": "të ngjashme me margaritarët e ruajtur,"
    },
    {
      "surah": 56,
      "ayah": 24,
      "verseKey": "56:24",
      "arabic": "جَزَآءًۢ بِمَا كَانُوا۟ يَعْمَلُونَ",
      "translationSq": "si shpërblim për atë që kanë punuar."
    },
    {
      "surah": 56,
      "ayah": 25,
      "verseKey": "56:25",
      "arabic": "لَا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا تَأْثِيمًا",
      "translationSq": "Aty nuk do të dëgjojnë biseda të kota, as fjalë gjynahesh,"
    },
    {
      "surah": 56,
      "ayah": 26,
      "verseKey": "56:26",
      "arabic": "إِلَّا قِيلًا سَلَـٰمًا سَلَـٰمًا",
      "translationSq": "por vetëm fjalët “Paqe, paqe”!"
    },
    {
      "surah": 56,
      "ayah": 27,
      "verseKey": "56:27",
      "arabic": "وَأَصْحَـٰبُ ٱلْيَمِينِ مَآ أَصْحَـٰبُ ٱلْيَمِينِ",
      "translationSq": "E njerëzit e së djathtës – sa të nderuar që janë fatlumët!"
    },
    {
      "surah": 56,
      "ayah": 28,
      "verseKey": "56:28",
      "arabic": "فِى سِدْرٍ مَّخْضُودٍ",
      "translationSq": "Ata do të qëndrojnë në mes të lotusëve pa gjemba"
    },
    {
      "surah": 56,
      "ayah": 29,
      "verseKey": "56:29",
      "arabic": "وَطَلْحٍ مَّنضُودٍ",
      "translationSq": "dhe bananeve të mbushura me fruta,"
    },
    {
      "surah": 56,
      "ayah": 30,
      "verseKey": "56:30",
      "arabic": "وَظِلٍّ مَّمْدُودٍ",
      "translationSq": "nën hije të gjera,"
    },
    {
      "surah": 56,
      "ayah": 31,
      "verseKey": "56:31",
      "arabic": "وَمَآءٍ مَّسْكُوبٍ",
      "translationSq": "pranë një uji rrjedhës,"
    },
    {
      "surah": 56,
      "ayah": 32,
      "verseKey": "56:32",
      "arabic": "وَفَـٰكِهَةٍ كَثِيرَةٍ",
      "translationSq": "dhe mes frutave të llojllojshme,"
    },
    {
      "surah": 56,
      "ayah": 33,
      "verseKey": "56:33",
      "arabic": "لَّا مَقْطُوعَةٍ وَلَا مَمْنُوعَةٍ",
      "translationSq": "të cilat kurrë nuk sosen, as nuk janë të ndaluara;"
    },
    {
      "surah": 56,
      "ayah": 34,
      "verseKey": "56:34",
      "arabic": "وَفُرُشٍ مَّرْفُوعَةٍ",
      "translationSq": "dhe në shtroje të ngritura (ku i presin hyritë),"
    },
    {
      "surah": 56,
      "ayah": 35,
      "verseKey": "56:35",
      "arabic": "إِنَّآ أَنشَأْنَـٰهُنَّ إِنشَآءً",
      "translationSq": "të cilat Ne i kemi krijuar në një formë të veçantë (jo të lindura),"
    },
    {
      "surah": 56,
      "ayah": 36,
      "verseKey": "56:36",
      "arabic": "فَجَعَلْنَـٰهُنَّ أَبْكَارًا",
      "translationSq": "dhe i kemi bërë ato virgjëresha,"
    },
    {
      "surah": 56,
      "ayah": 37,
      "verseKey": "56:37",
      "arabic": "عُرُبًا أَتْرَابًا",
      "translationSq": "të dashura për bashkëshortët e tyre dhe moshatare me ta,"
    },
    {
      "surah": 56,
      "ayah": 38,
      "verseKey": "56:38",
      "arabic": "لِّأَصْحَـٰبِ ٱلْيَمِينِ",
      "translationSq": "për njerëzit e së djathtës."
    },
    {
      "surah": 56,
      "ayah": 39,
      "verseKey": "56:39",
      "arabic": "ثُلَّةٌ مِّنَ ٱلْأَوَّلِينَ",
      "translationSq": "Janë shumë nga të lashtët"
    },
    {
      "surah": 56,
      "ayah": 40,
      "verseKey": "56:40",
      "arabic": "وَثُلَّةٌ مِّنَ ٱلْـَٔاخِرِينَ",
      "translationSq": "e shumë edhe nga të mëvonshmit."
    },
    {
      "surah": 56,
      "ayah": 41,
      "verseKey": "56:41",
      "arabic": "وَأَصْحَـٰبُ ٱلشِّمَالِ مَآ أَصْحَـٰبُ ٱلشِّمَالِ",
      "translationSq": "Po njerëzit e së majtës – sa të poshtëruar janë fatkeqët!"
    },
    {
      "surah": 56,
      "ayah": 42,
      "verseKey": "56:42",
      "arabic": "فِى سَمُومٍ وَحَمِيمٍ",
      "translationSq": "Ata do të jenë në afshin përcëllues të zjarrit dhe ujit të valuar"
    },
    {
      "surah": 56,
      "ayah": 43,
      "verseKey": "56:43",
      "arabic": "وَظِلٍّ مِّن يَحْمُومٍ",
      "translationSq": "dhe nën hijen e një tymi të zi,"
    },
    {
      "surah": 56,
      "ayah": 44,
      "verseKey": "56:44",
      "arabic": "لَّا بَارِدٍ وَلَا كَرِيمٍ",
      "translationSq": "e cila nuk do të jetë as e freskët e as e këndshme."
    },
    {
      "surah": 56,
      "ayah": 45,
      "verseKey": "56:45",
      "arabic": "إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُتْرَفِينَ",
      "translationSq": "Ata, para kësaj, jetonin në luks"
    },
    {
      "surah": 56,
      "ayah": 46,
      "verseKey": "56:46",
      "arabic": "وَكَانُوا۟ يُصِرُّونَ عَلَى ٱلْحِنثِ ٱلْعَظِيمِ",
      "translationSq": "dhe në vazhdimësi bënin gjynahe të rënda,"
    },
    {
      "surah": 56,
      "ayah": 47,
      "verseKey": "56:47",
      "arabic": "وَكَانُوا۟ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَـٰمًا أَءِنَّا لَمَبْعُوثُونَ",
      "translationSq": "duke thënë: “Vallë, pasi të vdesim e të bëhemi pluhur e eshtra, vërtet do të ringjallemi?!"
    },
    {
      "surah": 56,
      "ayah": 48,
      "verseKey": "56:48",
      "arabic": "أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ",
      "translationSq": "Vallë, edhe të parët tanë të lashtë?!”"
    },
    {
      "surah": 56,
      "ayah": 49,
      "verseKey": "56:49",
      "arabic": "قُلْ إِنَّ ٱلْأَوَّلِينَ وَٱلْـَٔاخِرِينَ",
      "translationSq": "Thuaju (o Muhamed): “Me siguri, edhe të parët, edhe të mbramët,"
    },
    {
      "surah": 56,
      "ayah": 50,
      "verseKey": "56:50",
      "arabic": "لَمَجْمُوعُونَ إِلَىٰ مِيقَـٰتِ يَوْمٍ مَّعْلُومٍ",
      "translationSq": "do të tubohen në një ditë të caktuar."
    },
    {
      "surah": 56,
      "ayah": 51,
      "verseKey": "56:51",
      "arabic": "ثُمَّ إِنَّكُمْ أَيُّهَا ٱلضَّآلُّونَ ٱلْمُكَذِّبُونَ",
      "translationSq": "Dhe atëherë ju, o jobesimtarë të humbur,"
    },
    {
      "surah": 56,
      "ayah": 52,
      "verseKey": "56:52",
      "arabic": "لَـَٔاكِلُونَ مِن شَجَرٍ مِّن زَقُّومٍ",
      "translationSq": "me siguri që do të hani nga pema e zekumit,"
    },
    {
      "surah": 56,
      "ayah": 53,
      "verseKey": "56:53",
      "arabic": "فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ",
      "translationSq": "me të cilën do të mbushni barkun."
    },
    {
      "surah": 56,
      "ayah": 54,
      "verseKey": "56:54",
      "arabic": "فَشَـٰرِبُونَ عَلَيْهِ مِنَ ٱلْحَمِيمِ",
      "translationSq": "Pastaj do të pini ujë të valuar,"
    },
    {
      "surah": 56,
      "ayah": 55,
      "verseKey": "56:55",
      "arabic": "فَشَـٰرِبُونَ شُرْبَ ٱلْهِيمِ",
      "translationSq": "madje do të pini ashtu siç pi deveja e etshme”."
    },
    {
      "surah": 56,
      "ayah": 56,
      "verseKey": "56:56",
      "arabic": "هَـٰذَا نُزُلُهُمْ يَوْمَ ٱلدِّينِ",
      "translationSq": "Kështu do të jetë gostia e tyre në Ditën e Llogarisë!"
    },
    {
      "surah": 56,
      "ayah": 57,
      "verseKey": "56:57",
      "arabic": "نَحْنُ خَلَقْنَـٰكُمْ فَلَوْلَا تُصَدِّقُونَ",
      "translationSq": "Ne ju krijuam – e pse nuk e pranoni të vërtetën?"
    },
    {
      "surah": 56,
      "ayah": 58,
      "verseKey": "56:58",
      "arabic": "أَفَرَءَيْتُم مَّا تُمْنُونَ",
      "translationSq": "A e keni parë farën që e hidhni?"
    },
    {
      "surah": 56,
      "ayah": 59,
      "verseKey": "56:59",
      "arabic": "ءَأَنتُمْ تَخْلُقُونَهُۥٓ أَمْ نَحْنُ ٱلْخَـٰلِقُونَ",
      "translationSq": "A jeni ju që e krijoni atë apo jemi Ne krijuesit e saj?"
    },
    {
      "surah": 56,
      "ayah": 60,
      "verseKey": "56:60",
      "arabic": "نَحْنُ قَدَّرْنَا بَيْنَكُمُ ٱلْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ",
      "translationSq": "Ne e caktojmë vdekjen tuaj dhe askush nuk mund të na pengojë"
    },
    {
      "surah": 56,
      "ayah": 61,
      "verseKey": "56:61",
      "arabic": "عَلَىٰٓ أَن نُّبَدِّلَ أَمْثَـٰلَكُمْ وَنُنشِئَكُمْ فِى مَا لَا تَعْلَمُونَ",
      "translationSq": "që t’jua ndryshojmë trajtën dhe t’ju rikrijojmë ashtu si nuk e dini (në Ditën e Ringjalljes)."
    },
    {
      "surah": 56,
      "ayah": 62,
      "verseKey": "56:62",
      "arabic": "وَلَقَدْ عَلِمْتُمُ ٱلنَّشْأَةَ ٱلْأُولَىٰ فَلَوْلَا تَذَكَّرُونَ",
      "translationSq": "Sigurisht, ju e dini krijimin e parë (prej një pike fare), atëherë përse nuk mendoni?!"
    },
    {
      "surah": 56,
      "ayah": 63,
      "verseKey": "56:63",
      "arabic": "أَفَرَءَيْتُم مَّا تَحْرُثُونَ",
      "translationSq": "A shihni atë që mbillni?"
    },
    {
      "surah": 56,
      "ayah": 64,
      "verseKey": "56:64",
      "arabic": "ءَأَنتُمْ تَزْرَعُونَهُۥٓ أَمْ نَحْنُ ٱلزَّٰرِعُونَ",
      "translationSq": "Vallë, ju e bëni atë që të mbijë apo jemi Ne rritësit e saj?"
    },
    {
      "surah": 56,
      "ayah": 65,
      "verseKey": "56:65",
      "arabic": "لَوْ نَشَآءُ لَجَعَلْنَـٰهُ حُطَـٰمًا فَظَلْتُمْ تَفَكَّهُونَ",
      "translationSq": "Nëse duam, Ne e lëmë fyçkë dhe ju do të çuditeni"
    },
    {
      "surah": 56,
      "ayah": 66,
      "verseKey": "56:66",
      "arabic": "إِنَّا لَمُغْرَمُونَ",
      "translationSq": "(e do të thoni): “Ne jemi të dëmtuar,"
    },
    {
      "surah": 56,
      "ayah": 67,
      "verseKey": "56:67",
      "arabic": "بَلْ نَحْنُ مَحْرُومُونَ",
      "translationSq": "madje jemi krejt të privuar (nga furnizimi)!”"
    },
    {
      "surah": 56,
      "ayah": 68,
      "verseKey": "56:68",
      "arabic": "أَفَرَءَيْتُمُ ٱلْمَآءَ ٱلَّذِى تَشْرَبُونَ",
      "translationSq": "A e shihni ujin që pini?"
    },
    {
      "surah": 56,
      "ayah": 69,
      "verseKey": "56:69",
      "arabic": "ءَأَنتُمْ أَنزَلْتُمُوهُ مِنَ ٱلْمُزْنِ أَمْ نَحْنُ ٱلْمُنزِلُونَ",
      "translationSq": "Vallë, ju e zbrisni atë prej reve apo Ne e zbresim?"
    },
    {
      "surah": 56,
      "ayah": 70,
      "verseKey": "56:70",
      "arabic": "لَوْ نَشَآءُ جَعَلْنَـٰهُ أُجَاجًا فَلَوْلَا تَشْكُرُونَ",
      "translationSq": "Nëse duam, Ne e bëjmë atë të njelmët, andaj përse nuk jeni mirënjohës?!"
    },
    {
      "surah": 56,
      "ayah": 71,
      "verseKey": "56:71",
      "arabic": "أَفَرَءَيْتُمُ ٱلنَّارَ ٱلَّتِى تُورُونَ",
      "translationSq": "A e shihni zjarrin që e ndizni?"
    },
    {
      "surah": 56,
      "ayah": 72,
      "verseKey": "56:72",
      "arabic": "ءَأَنتُمْ أَنشَأْتُمْ شَجَرَتَهَآ أَمْ نَحْنُ ٱلْمُنشِـُٔونَ",
      "translationSq": "Vallë, ju i keni bërë drutë për të apo Ne i kemi bërë?!"
    },
    {
      "surah": 56,
      "ayah": 73,
      "verseKey": "56:73",
      "arabic": "نَحْنُ جَعَلْنَـٰهَا تَذْكِرَةً وَمَتَـٰعًا لِّلْمُقْوِينَ",
      "translationSq": "Ne e kemi bërë atë përkujtues (të zjarrit të Xhehenemit) dhe, që t’u sjellë dobi nevojtarëve,"
    },
    {
      "surah": 56,
      "ayah": 74,
      "verseKey": "56:74",
      "arabic": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ",
      "translationSq": "prandaj lavdëroje emrin e Zotit tënd të Madhërishëm!"
    },
    {
      "surah": 56,
      "ayah": 75,
      "verseKey": "56:75",
      "arabic": "۞ فَلَآ أُقْسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ",
      "translationSq": "Betohem në çastin e perëndimit të yjeve,"
    },
    {
      "surah": 56,
      "ayah": 76,
      "verseKey": "56:76",
      "arabic": "وَإِنَّهُۥ لَقَسَمٌ لَّوْ تَعْلَمُونَ عَظِيمٌ",
      "translationSq": "- e ky është betim i madh, veç sikur ta dinit"
    },
    {
      "surah": 56,
      "ayah": 77,
      "verseKey": "56:77",
      "arabic": "إِنَّهُۥ لَقُرْءَانٌ كَرِيمٌ",
      "translationSq": "se ky është vërtet një Kuran i nderuar,"
    },
    {
      "surah": 56,
      "ayah": 78,
      "verseKey": "56:78",
      "arabic": "فِى كِتَـٰبٍ مَّكْنُونٍ",
      "translationSq": "në Librin e ruajtur."
    },
    {
      "surah": 56,
      "ayah": 79,
      "verseKey": "56:79",
      "arabic": "لَّا يَمَسُّهُۥٓ إِلَّا ٱلْمُطَهَّرُونَ",
      "translationSq": "Atë (Kuranin) e prekin vetëm të pastrit."
    },
    {
      "surah": 56,
      "ayah": 80,
      "verseKey": "56:80",
      "arabic": "تَنزِيلٌ مِّن رَّبِّ ٱلْعَـٰلَمِينَ",
      "translationSq": "Ai është Shpallje prej Zotit të botëve."
    },
    {
      "surah": 56,
      "ayah": 81,
      "verseKey": "56:81",
      "arabic": "أَفَبِهَـٰذَا ٱلْحَدِيثِ أَنتُم مُّدْهِنُونَ",
      "translationSq": "Vallë, një Fjalë të tillë ju e mohoni"
    },
    {
      "surah": 56,
      "ayah": 82,
      "verseKey": "56:82",
      "arabic": "وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَ",
      "translationSq": "dhe e bëni detyrën tuaj (të përditshme) ta përgënjeshtroni?!"
    },
    {
      "surah": 56,
      "ayah": 83,
      "verseKey": "56:83",
      "arabic": "فَلَوْلَآ إِذَا بَلَغَتِ ٱلْحُلْقُومَ",
      "translationSq": "Atëherë, përse kur (dikujt) i vjen (shpirti) në grykë"
    },
    {
      "surah": 56,
      "ayah": 84,
      "verseKey": "56:84",
      "arabic": "وَأَنتُمْ حِينَئِذٍ تَنظُرُونَ",
      "translationSq": "para syve tuaj,"
    },
    {
      "surah": 56,
      "ayah": 85,
      "verseKey": "56:85",
      "arabic": "وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَـٰكِن لَّا تُبْصِرُونَ",
      "translationSq": "- ndërkohë që Ne jemi më afër atij se ju, por ju nuk e vini re"
    },
    {
      "surah": 56,
      "ayah": 86,
      "verseKey": "56:86",
      "arabic": "فَلَوْلَآ إِن كُنتُمْ غَيْرَ مَدِينِينَ",
      "translationSq": "përse pra, nëse nuk do të gjykoheni (në jetën e përtejme),"
    },
    {
      "surah": 56,
      "ayah": 87,
      "verseKey": "56:87",
      "arabic": "تَرْجِعُونَهَآ إِن كُنتُمْ صَـٰدِقِينَ",
      "translationSq": "ju nuk ia ktheni shpirtin atij? Përgjigjjuni kësaj, nëse thoni të vërtetën!"
    },
    {
      "surah": 56,
      "ayah": 88,
      "verseKey": "56:88",
      "arabic": "فَأَمَّآ إِن كَانَ مِنَ ٱلْمُقَرَّبِينَ",
      "translationSq": "Kështu, nëse ai (në agoni) është nga ata që janë të afërt (me Allahun),"
    },
    {
      "surah": 56,
      "ayah": 89,
      "verseKey": "56:89",
      "arabic": "فَرَوْحٌ وَرَيْحَانٌ وَجَنَّتُ نَعِيمٍ",
      "translationSq": "do të ketë prehje, kënaqësi dhe dhunti të Xhenetit."
    },
    {
      "surah": 56,
      "ayah": 90,
      "verseKey": "56:90",
      "arabic": "وَأَمَّآ إِن كَانَ مِنْ أَصْحَـٰبِ ٱلْيَمِينِ",
      "translationSq": "E, nëse është nga njerëzit e së djathtës,"
    },
    {
      "surah": 56,
      "ayah": 91,
      "verseKey": "56:91",
      "arabic": "فَسَلَـٰمٌ لَّكَ مِنْ أَصْحَـٰبِ ٱلْيَمِينِ",
      "translationSq": "(ai do të përshëndetet) “Paqe për ty” nga njerëzit e së djathtës."
    },
    {
      "surah": 56,
      "ayah": 92,
      "verseKey": "56:92",
      "arabic": "وَأَمَّآ إِن كَانَ مِنَ ٱلْمُكَذِّبِينَ ٱلضَّآلِّينَ",
      "translationSq": "Por, nëse (ai në agoni) është nga përgënjeshtruesit e humbur,"
    },
    {
      "surah": 56,
      "ayah": 93,
      "verseKey": "56:93",
      "arabic": "فَنُزُلٌ مِّنْ حَمِيمٍ",
      "translationSq": "ai do të gostitet me ujë të valuar"
    },
    {
      "surah": 56,
      "ayah": 94,
      "verseKey": "56:94",
      "arabic": "وَتَصْلِيَةُ جَحِيمٍ",
      "translationSq": "dhe do të përcëllohet në Zjarrin e flakëruar (të Xhehenemit)."
    },
    {
      "surah": 56,
      "ayah": 95,
      "verseKey": "56:95",
      "arabic": "إِنَّ هَـٰذَا لَهُوَ حَقُّ ٱلْيَقِينِ",
      "translationSq": "Pa dyshim, kjo është e Vërteta e sigurt."
    },
    {
      "surah": 56,
      "ayah": 96,
      "verseKey": "56:96",
      "arabic": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ",
      "translationSq": "Andaj lavdëroje emrin e Zotit tënd të Madhërishëm!"
    }
  ]
}