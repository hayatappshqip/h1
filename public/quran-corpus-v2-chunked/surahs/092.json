{
  "surah": 92,
  "verseCount": 21,
  "verses": [
    {
      "surah": 92,
      "ayah": 1,
      "verseKey": "92:1",
      "arabic": " وَٱلَّيْلِ إِذَا يَغْشَىٰ",
      "translationSq": "Për natën që mbulon (me terr),"
    },
    {
      "surah": 92,
      "ayah": 2,
      "verseKey": "92:2",
      "arabic": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ",
      "translationSq": "për ditën që agon"
    },
    {
      "surah": 92,
      "ayah": 3,
      "verseKey": "92:3",
      "arabic": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ",
      "translationSq": "dhe për Atë që ka krijuar mashkullin dhe femrën!"
    },
    {
      "surah": 92,
      "ayah": 4,
      "verseKey": "92:4",
      "arabic": "إِنَّ سَعْيَكُمْ لَشَتَّىٰ",
      "translationSq": "Vërtet, veprat tuaja janë të ndryshme."
    },
    {
      "surah": 92,
      "ayah": 5,
      "verseKey": "92:5",
      "arabic": "فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ",
      "translationSq": "Sa për atë që jep (për hir të Allahut), ka frikë (nga Ai)"
    },
    {
      "surah": 92,
      "ayah": 6,
      "verseKey": "92:6",
      "arabic": "وَصَدَّقَ بِٱلْحُسْنَىٰ",
      "translationSq": "dhe dëshmon për vërtetësinë e më të bukurës (besimit),"
    },
    {
      "surah": 92,
      "ayah": 7,
      "verseKey": "92:7",
      "arabic": "فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ",
      "translationSq": "Ne do t’ia lehtësojmë atij rrugën drejt shpëtimit."
    },
    {
      "surah": 92,
      "ayah": 8,
      "verseKey": "92:8",
      "arabic": "وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ",
      "translationSq": "Kurse atij që është koprrac, ndihet i vetëmjaftueshëm,"
    },
    {
      "surah": 92,
      "ayah": 9,
      "verseKey": "92:9",
      "arabic": "وَكَذَّبَ بِٱلْحُسْنَىٰ",
      "translationSq": "dhe e quan gënjeshtër më të bukurën (besimin),"
    },
    {
      "surah": 92,
      "ayah": 10,
      "verseKey": "92:10",
      "arabic": "فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ",
      "translationSq": "Ne do t’ia lehtësojmë rrugën drejt dënimit,"
    },
    {
      "surah": 92,
      "ayah": 11,
      "verseKey": "92:11",
      "arabic": "وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ",
      "translationSq": "e, kur të hidhet (në zjarr), pasuria e tij nuk do t’i bëjë dobi."
    },
    {
      "surah": 92,
      "ayah": 12,
      "verseKey": "92:12",
      "arabic": "إِنَّ عَلَيْنَا لَلْهُدَىٰ",
      "translationSq": "Neve na përket që t’ua tregojmë rrugën e drejtë,"
    },
    {
      "surah": 92,
      "ayah": 13,
      "verseKey": "92:13",
      "arabic": "وَإِنَّ لَنَا لَلْـَٔاخِرَةَ وَٱلْأُولَىٰ",
      "translationSq": "dhe, me të vërtetë, e Jona është ajo botë dhe kjo botë!"
    },
    {
      "surah": 92,
      "ayah": 14,
      "verseKey": "92:14",
      "arabic": "فَأَنذَرْتُكُمْ نَارًا تَلَظَّىٰ",
      "translationSq": "Prandaj Unë ju kam tërhequr vërejtjen me një zjarr që flakëron,"
    },
    {
      "surah": 92,
      "ayah": 15,
      "verseKey": "92:15",
      "arabic": "لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى",
      "translationSq": "ku do të hidhet vetëm më i keqi,"
    },
    {
      "surah": 92,
      "ayah": 16,
      "verseKey": "92:16",
      "arabic": "ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ",
      "translationSq": "që ka mohuar dhe është larguar nga besimi."
    },
    {
      "surah": 92,
      "ayah": 17,
      "verseKey": "92:17",
      "arabic": "وَسَيُجَنَّبُهَا ٱلْأَتْقَى",
      "translationSq": "E do të mbahet larg tij (zjarrit) më i devotshmi (që ruhet nga gjynahet),"
    },
    {
      "surah": 92,
      "ayah": 18,
      "verseKey": "92:18",
      "arabic": "ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ",
      "translationSq": "që e jep pasurinë e tij, duke pastruar veten"
    },
    {
      "surah": 92,
      "ayah": 19,
      "verseKey": "92:19",
      "arabic": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍ تُجْزَىٰٓ",
      "translationSq": "dhe duke mos pritur shpërblim prej dikujt tjetër për këtë,"
    },
    {
      "surah": 92,
      "ayah": 20,
      "verseKey": "92:20",
      "arabic": "إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ",
      "translationSq": "por vetëm për të kërkuar Fytyrën (kënaqësinë) e Zotit të tij, më të Lartit."
    },
    {
      "surah": 92,
      "ayah": 21,
      "verseKey": "92:21",
      "arabic": "وَلَسَوْفَ يَرْضَىٰ",
      "translationSq": "Dhe ai, me siguri, do të jetë i kënaqur!"
    }
  ]
}