{
  "surah": 81,
  "verseCount": 29,
  "verses": [
    {
      "surah": 81,
      "ayah": 1,
      "verseKey": "81:1",
      "arabic": " إِذَا ٱلشَّمْسُ كُوِّرَتْ",
      "translationSq": "Kur Dielli të mblidhet e të humbë shkëlqimin;"
    },
    {
      "surah": 81,
      "ayah": 2,
      "verseKey": "81:2",
      "arabic": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ",
      "translationSq": "kur yjet të rrëzohen"
    },
    {
      "surah": 81,
      "ayah": 3,
      "verseKey": "81:3",
      "arabic": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ",
      "translationSq": "dhe malet të lëvizin tutje;"
    },
    {
      "surah": 81,
      "ayah": 4,
      "verseKey": "81:4",
      "arabic": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ",
      "translationSq": "kur devetë barrse të braktisen"
    },
    {
      "surah": 81,
      "ayah": 5,
      "verseKey": "81:5",
      "arabic": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ",
      "translationSq": "dhe egërsirat të tubohen;"
    },
    {
      "surah": 81,
      "ayah": 6,
      "verseKey": "81:6",
      "arabic": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ",
      "translationSq": "kur detet të vlojnë"
    },
    {
      "surah": 81,
      "ayah": 7,
      "verseKey": "81:7",
      "arabic": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ",
      "translationSq": "dhe shpirtrat të bashkohen (me trupat);"
    },
    {
      "surah": 81,
      "ayah": 8,
      "verseKey": "81:8",
      "arabic": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ",
      "translationSq": "kur foshnja e varrosur për së gjalli të pyetet"
    },
    {
      "surah": 81,
      "ayah": 9,
      "verseKey": "81:9",
      "arabic": "بِأَىِّ ذَنۢبٍ قُتِلَتْ",
      "translationSq": "për çfarë faji ishte vrarë;"
    },
    {
      "surah": 81,
      "ayah": 10,
      "verseKey": "81:10",
      "arabic": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ",
      "translationSq": "kur fletët të shpërndahen"
    },
    {
      "surah": 81,
      "ayah": 11,
      "verseKey": "81:11",
      "arabic": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ",
      "translationSq": "dhe qielli të zhvishet;"
    },
    {
      "surah": 81,
      "ayah": 12,
      "verseKey": "81:12",
      "arabic": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ",
      "translationSq": "kur Xhehenemi të flakërojë"
    },
    {
      "surah": 81,
      "ayah": 13,
      "verseKey": "81:13",
      "arabic": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ",
      "translationSq": "dhe Xheneti të afrohet:"
    },
    {
      "surah": 81,
      "ayah": 14,
      "verseKey": "81:14",
      "arabic": "عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ",
      "translationSq": "atëherë çdokush do të marrë vesh çfarë kishte përgatitur (për këtë Ditë)."
    },
    {
      "surah": 81,
      "ayah": 15,
      "verseKey": "81:15",
      "arabic": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ",
      "translationSq": "Betohem për ata (planetë) që tërhiqen,"
    },
    {
      "surah": 81,
      "ayah": 16,
      "verseKey": "81:16",
      "arabic": "ٱلْجَوَارِ ٱلْكُنَّسِ",
      "translationSq": "që lindin e perëndojnë,"
    },
    {
      "surah": 81,
      "ayah": 17,
      "verseKey": "81:17",
      "arabic": "وَٱلَّيْلِ إِذَا عَسْعَسَ",
      "translationSq": "për natën kur bie terri"
    },
    {
      "surah": 81,
      "ayah": 18,
      "verseKey": "81:18",
      "arabic": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ",
      "translationSq": "e për agimin kur nis të zbardhë,"
    },
    {
      "surah": 81,
      "ayah": 19,
      "verseKey": "81:19",
      "arabic": "إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ",
      "translationSq": "se ky (Kuran) është Fjalë e (kumtuar prej) një të Dërguari fisnik,"
    },
    {
      "surah": 81,
      "ayah": 20,
      "verseKey": "81:20",
      "arabic": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ",
      "translationSq": "që zotëron fuqi dhe pozitë të lartë te Zoti i Fronit"
    },
    {
      "surah": 81,
      "ayah": 21,
      "verseKey": "81:21",
      "arabic": "مُّطَاعٍ ثَمَّ أَمِينٍ",
      "translationSq": "e që është i respektuar atje dhe besnik."
    },
    {
      "surah": 81,
      "ayah": 22,
      "verseKey": "81:22",
      "arabic": "وَمَا صَاحِبُكُم بِمَجْنُونٍ",
      "translationSq": "Shoku juaj nuk është i marrë."
    },
    {
      "surah": 81,
      "ayah": 23,
      "verseKey": "81:23",
      "arabic": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ",
      "translationSq": "Ai e ka parë atë në horizontin e qartë"
    },
    {
      "surah": 81,
      "ayah": 24,
      "verseKey": "81:24",
      "arabic": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ",
      "translationSq": "dhe nuk mbulon asnjë të fshehtë prej së Padukshmes."
    },
    {
      "surah": 81,
      "ayah": 25,
      "verseKey": "81:25",
      "arabic": "وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍ رَّجِيمٍ",
      "translationSq": "As ky (Kuran) nuk është fjalë e djallit të mallkuar."
    },
    {
      "surah": 81,
      "ayah": 26,
      "verseKey": "81:26",
      "arabic": "فَأَيْنَ تَذْهَبُونَ",
      "translationSq": "Prandaj, nga po ia mbani?"
    },
    {
      "surah": 81,
      "ayah": 27,
      "verseKey": "81:27",
      "arabic": "إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ",
      "translationSq": "Ai është veçse këshillë për botët:"
    },
    {
      "surah": 81,
      "ayah": 28,
      "verseKey": "81:28",
      "arabic": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ",
      "translationSq": "për secilin nga ju që dëshiron të ndjekë rrugën e drejtë."
    },
    {
      "surah": 81,
      "ayah": 29,
      "verseKey": "81:29",
      "arabic": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ",
      "translationSq": "Por ju nuk mund të dëshironi, përveçse me vullnetin e Allahut, Zotit të botëve!"
    }
  ]
}