{
  "surah": 102,
  "verseCount": 8,
  "verses": [
    {
      "surah": 102,
      "ayah": 1,
      "verseKey": "102:1",
      "arabic": " أَلْهَىٰكُمُ ٱلتَّكَاثُرُ",
      "translationSq": "Ju ka hutuar rivaliteti për të shtuar,"
    },
    {
      "surah": 102,
      "ayah": 2,
      "verseKey": "102:2",
      "arabic": "حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ",
      "translationSq": "derisa të shkoni në varre."
    },
    {
      "surah": 102,
      "ayah": 3,
      "verseKey": "102:3",
      "arabic": "كَلَّا سَوْفَ تَعْلَمُونَ",
      "translationSq": "Gjithsesi, do ta merrni vesh!"
    },
    {
      "surah": 102,
      "ayah": 4,
      "verseKey": "102:4",
      "arabic": "ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ",
      "translationSq": "Madje, së shpejti do ta merrni vesh!"
    },
    {
      "surah": 102,
      "ayah": 5,
      "verseKey": "102:5",
      "arabic": "كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ",
      "translationSq": "Kujdes! Ah, sikur ta dinit të vërtetën me siguri!"
    },
    {
      "surah": 102,
      "ayah": 6,
      "verseKey": "102:6",
      "arabic": "لَتَرَوُنَّ ٱلْجَحِيمَ",
      "translationSq": "Sigurisht që do ta shihni Zjarrin flakërues!"
    },
    {
      "surah": 102,
      "ayah": 7,
      "verseKey": "102:7",
      "arabic": "ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ",
      "translationSq": "Pastaj, me të vërtetë, do ta shihni atë me syrin e sigurisë."
    },
    {
      "surah": 102,
      "ayah": 8,
      "verseKey": "102:8",
      "arabic": "ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ",
      "translationSq": "Pastaj, atë Ditë, do të pyeteni për kënaqësitë (e kësaj bote)!"
    }
  ]
}