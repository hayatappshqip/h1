{
  "surah": 100,
  "verseCount": 11,
  "verses": [
    {
      "surah": 100,
      "ayah": 1,
      "verseKey": "100:1",
      "arabic": " وَٱلْعَـٰدِيَـٰتِ ضَبْحًا",
      "translationSq": "Betohem për ata (kuaj) që vrapojnë duke dihatur,"
    },
    {
      "surah": 100,
      "ayah": 2,
      "verseKey": "100:2",
      "arabic": "فَٱلْمُورِيَـٰتِ قَدْحًا",
      "translationSq": "që nxjerrin xixa nga thundrat"
    },
    {
      "surah": 100,
      "ayah": 3,
      "verseKey": "100:3",
      "arabic": "فَٱلْمُغِيرَٰتِ صُبْحًا",
      "translationSq": "dhe trokojnë për sulm në mëngjes,"
    },
    {
      "surah": 100,
      "ayah": 4,
      "verseKey": "100:4",
      "arabic": "فَأَثَرْنَ بِهِۦ نَقْعًا",
      "translationSq": "duke çuar re pluhuri,"
    },
    {
      "surah": 100,
      "ayah": 5,
      "verseKey": "100:5",
      "arabic": "فَوَسَطْنَ بِهِۦ جَمْعًا",
      "translationSq": "ndërsa çajnë armikun në dysh,"
    },
    {
      "surah": 100,
      "ayah": 6,
      "verseKey": "100:6",
      "arabic": "إِنَّ ٱلْإِنسَـٰنَ لِرَبِّهِۦ لَكَنُودٌ",
      "translationSq": "se njeriu është vërtet mosmirënjohës ndaj Zotit të vet,"
    },
    {
      "surah": 100,
      "ayah": 7,
      "verseKey": "100:7",
      "arabic": "وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌ",
      "translationSq": "dhe ai, pa dyshim, këtë e dëshmon."
    },
    {
      "surah": 100,
      "ayah": 8,
      "verseKey": "100:8",
      "arabic": "وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ",
      "translationSq": "Vërtet, ai është i babëzitur për pasuri."
    },
    {
      "surah": 100,
      "ayah": 9,
      "verseKey": "100:9",
      "arabic": "۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ",
      "translationSq": "Vallë, a nuk e di ai se kur të nxirren jashtë ata që gjenden në varre"
    },
    {
      "surah": 100,
      "ayah": 10,
      "verseKey": "100:10",
      "arabic": "وَحُصِّلَ مَا فِى ٱلصُّدُورِ",
      "translationSq": "dhe, kur të dalë në shesh ajo që është në gjokse,"
    },
    {
      "surah": 100,
      "ayah": 11,
      "verseKey": "100:11",
      "arabic": "إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍ لَّخَبِيرٌۢ",
      "translationSq": "Zoti i tyre, me siguri, atë Ditë di çdo gjë për ta?!"
    }
  ]
}