{
  "surah": 87,
  "verseCount": 19,
  "verses": [
    {
      "surah": 87,
      "ayah": 1,
      "verseKey": "87:1",
      "arabic": " سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى",
      "translationSq": "Lavdëro emrin e Zotit tënd, më të Lartit,"
    },
    {
      "surah": 87,
      "ayah": 2,
      "verseKey": "87:2",
      "arabic": "ٱلَّذِى خَلَقَ فَسَوَّىٰ",
      "translationSq": "që ka krijuar gjithçka dhe e ka përpjesëtuar drejt;"
    },
    {
      "surah": 87,
      "ayah": 3,
      "verseKey": "87:3",
      "arabic": "وَٱلَّذِى قَدَّرَ فَهَدَىٰ",
      "translationSq": "që ka caktuar fatin e çdo gjëje dhe ia ka rrëfyer rrugën;"
    },
    {
      "surah": 87,
      "ayah": 4,
      "verseKey": "87:4",
      "arabic": "وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ",
      "translationSq": "që bën të rriten kullotat"
    },
    {
      "surah": 87,
      "ayah": 5,
      "verseKey": "87:5",
      "arabic": "فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ",
      "translationSq": "dhe pastaj të shndërrohen, të thahen e të vyshken."
    },
    {
      "surah": 87,
      "ayah": 6,
      "verseKey": "87:6",
      "arabic": "سَنُقْرِئُكَ فَلَا تَنسَىٰٓ",
      "translationSq": "Ne do të të bëjmë ty (Muhamed) të lexosh (Shpalljet Tona), kështu që nuk ke për të harruar,"
    },
    {
      "surah": 87,
      "ayah": 7,
      "verseKey": "87:7",
      "arabic": "إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ",
      "translationSq": "përveç asaj që do Allahu. Vërtet, Ai e di të dukshmen dhe çka është e fshehtë."
    },
    {
      "surah": 87,
      "ayah": 8,
      "verseKey": "87:8",
      "arabic": "وَنُيَسِّرُكَ لِلْيُسْرَىٰ",
      "translationSq": "Do të ta lehtësojmë ty rrugën e drejtë,"
    },
    {
      "surah": 87,
      "ayah": 9,
      "verseKey": "87:9",
      "arabic": "فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ",
      "translationSq": "prandaj këshillo, nëse këshilla do të jetë e dobishme!"
    },
    {
      "surah": 87,
      "ayah": 10,
      "verseKey": "87:10",
      "arabic": "سَيَذَّكَّرُ مَن يَخْشَىٰ",
      "translationSq": "Asaj do t’ia vërë veshin ai që (i) frikësohet (Allahut),"
    },
    {
      "surah": 87,
      "ayah": 11,
      "verseKey": "87:11",
      "arabic": "وَيَتَجَنَّبُهَا ٱلْأَشْقَى",
      "translationSq": "e do t’i shmanget vetëm më i keqi,"
    },
    {
      "surah": 87,
      "ayah": 12,
      "verseKey": "87:12",
      "arabic": "ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ",
      "translationSq": "i cili do të digjet në zjarrin e madh,"
    },
    {
      "surah": 87,
      "ayah": 13,
      "verseKey": "87:13",
      "arabic": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ",
      "translationSq": "ku as nuk do të vdesë, as nuk do të jetojë."
    },
    {
      "surah": 87,
      "ayah": 14,
      "verseKey": "87:14",
      "arabic": "قَدْ أَفْلَحَ مَن تَزَكَّىٰ",
      "translationSq": "I shpëtuar është ai që pastrohet,"
    },
    {
      "surah": 87,
      "ayah": 15,
      "verseKey": "87:15",
      "arabic": "وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ",
      "translationSq": "që e përmend emrin e Zotit të vet dhe që fal namaz!"
    },
    {
      "surah": 87,
      "ayah": 16,
      "verseKey": "87:16",
      "arabic": "بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا",
      "translationSq": "Por ju, përkundrazi, më shumë po e parapëlqeni jetën e kësaj bote,"
    },
    {
      "surah": 87,
      "ayah": 17,
      "verseKey": "87:17",
      "arabic": "وَٱلْـَٔاخِرَةُ خَيْرٌ وَأَبْقَىٰٓ",
      "translationSq": "ndonëse jeta tjetër është më e mirë dhe e amshuar."
    },
    {
      "surah": 87,
      "ayah": 18,
      "verseKey": "87:18",
      "arabic": "إِنَّ هَـٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ",
      "translationSq": "Kjo, me të vërtetë, ndodhet në Fletët e lashta,"
    },
    {
      "surah": 87,
      "ayah": 19,
      "verseKey": "87:19",
      "arabic": "صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ",
      "translationSq": "në Fletët e Ibrahimit dhe Musait."
    }
  ]
}