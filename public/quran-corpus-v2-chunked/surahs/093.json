{
  "surah": 93,
  "verseCount": 11,
  "verses": [
    {
      "surah": 93,
      "ayah": 1,
      "verseKey": "93:1",
      "arabic": " وَٱلضُّحَىٰ",
      "translationSq": "Betohem në shkëlqimin e paradites"
    },
    {
      "surah": 93,
      "ayah": 2,
      "verseKey": "93:2",
      "arabic": "وَٱلَّيْلِ إِذَا سَجَىٰ",
      "translationSq": "dhe në natën kur erret e qetësohet,"
    },
    {
      "surah": 93,
      "ayah": 3,
      "verseKey": "93:3",
      "arabic": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ",
      "translationSq": "se Zoti yt nuk të ka braktisur e as nuk të urren (o Muhamed)!"
    },
    {
      "surah": 93,
      "ayah": 4,
      "verseKey": "93:4",
      "arabic": "وَلَلْـَٔاخِرَةُ خَيْرٌ لَّكَ مِنَ ٱلْأُولَىٰ",
      "translationSq": "Natyrisht, jeta e ardhshme për ty është më e mirë se kjo jetë,"
    },
    {
      "surah": 93,
      "ayah": 5,
      "verseKey": "93:5",
      "arabic": "وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ",
      "translationSq": "e, sigurisht që Zoti yt do të të japë ty, sa të jesh i kënaqur."
    },
    {
      "surah": 93,
      "ayah": 6,
      "verseKey": "93:6",
      "arabic": "أَلَمْ يَجِدْكَ يَتِيمًا فَـَٔاوَىٰ",
      "translationSq": "A nuk ishe jetim e Ai të dha strehë?"
    },
    {
      "surah": 93,
      "ayah": 7,
      "verseKey": "93:7",
      "arabic": "وَوَجَدَكَ ضَآلًّا فَهَدَىٰ",
      "translationSq": "A nuk të gjeti të paditur (për Islamin) e të udhëzoi?"
    },
    {
      "surah": 93,
      "ayah": 8,
      "verseKey": "93:8",
      "arabic": "وَوَجَدَكَ عَآئِلًا فَأَغْنَىٰ",
      "translationSq": "A nuk ishe nevojtar e të bëri të mos ia kesh nevojën askujt?"
    },
    {
      "surah": 93,
      "ayah": 9,
      "verseKey": "93:9",
      "arabic": "فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ",
      "translationSq": "Prandaj, mos e shtyp jetimin,"
    },
    {
      "surah": 93,
      "ayah": 10,
      "verseKey": "93:10",
      "arabic": "وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ",
      "translationSq": "lypësin mos e shtyj me ashpërsi"
    },
    {
      "surah": 93,
      "ayah": 11,
      "verseKey": "93:11",
      "arabic": "وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ",
      "translationSq": "dhe shpalli dhuntitë e Zotit tënd!"
    }
  ]
}