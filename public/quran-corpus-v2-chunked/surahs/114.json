    {
      "surah": 114,
      "ayah": 1,
      "verseKey": "114:1",
      "arabic": " قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ",
      "translationSq": "Thuaj: “Kërkoj mbështetje te Zoti i njerëzve,"
    },
    {
      "surah": 114,
      "ayah": 2,
      "verseKey": "114:2",
      "arabic": "مَلِكِ ٱلنَّاسِ",
      "translationSq": "Sundimtari i njerëzve,"
    },
    {
      "surah": 114,
      "ayah": 3,
      "verseKey": "114:3",
      "arabic": "إِلَـٰهِ ٱلنَّاسِ",
      "translationSq": "i Adhuruari (i vetëm me të drejtë) i njerëzve,"
    },
    {
      "surah": 114,
      "ayah": 4,
      "verseKey": "114:4",
      "arabic": "مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ",
      "translationSq": "nga sherri i djallit cytës që fshihet (pasi cyt)"
    },
    {
      "surah": 114,
      "ayah": 5,
      "verseKey": "114:5",
      "arabic": "ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ",
      "translationSq": "e që hedh dyshime në gjokset e njerëzve,"
    },
    {
      "surah": 114,
      "ayah": 6,
      "verseKey": "114:6",
      "arabic": "مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ",
      "translationSq": "(qoftë ai djall) prej xhindeve apo njerëzve!”"
    }
  ]
}