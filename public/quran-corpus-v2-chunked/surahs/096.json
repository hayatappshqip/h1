{
  "surah": 96,
  "verseCount": 19,
  "verses": [
    {
      "surah": 96,
      "ayah": 1,
      "verseKey": "96:1",
      "arabic": " ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ",
      "translationSq": "Lexo me emrin e Zotit tënd, i Cili krijoi (gjithçka),"
    },
    {
      "surah": 96,
      "ayah": 2,
      "verseKey": "96:2",
      "arabic": "خَلَقَ ٱلْإِنسَـٰنَ مِنْ عَلَقٍ",
      "translationSq": "e krijoi njeriun nga një droçkë gjaku!"
    },
    {
      "surah": 96,
      "ayah": 3,
      "verseKey": "96:3",
      "arabic": "ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ",
      "translationSq": "Lexo! Zoti yt është Bujari më i madh,"
    },
    {
      "surah": 96,
      "ayah": 4,
      "verseKey": "96:4",
      "arabic": "ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ",
      "translationSq": "i Cili, me anë të penës ia mësoi,"
    },
    {
      "surah": 96,
      "ayah": 5,
      "verseKey": "96:5",
      "arabic": "عَلَّمَ ٱلْإِنسَـٰنَ مَا لَمْ يَعْلَمْ",
      "translationSq": "ia mësoi njeriut ato që nuk i dinte."
    },
    {
      "surah": 96,
      "ayah": 6,
      "verseKey": "96:6",
      "arabic": "كَلَّآ إِنَّ ٱلْإِنسَـٰنَ لَيَطْغَىٰٓ",
      "translationSq": "Por vërtet që njeriu shkel çdo cak,"
    },
    {
      "surah": 96,
      "ayah": 7,
      "verseKey": "96:7",
      "arabic": "أَن رَّءَاهُ ٱسْتَغْنَىٰٓ",
      "translationSq": "kur mendon se është i vetëmjaftueshëm."
    },
    {
      "surah": 96,
      "ayah": 8,
      "verseKey": "96:8",
      "arabic": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ",
      "translationSq": "Në të vërtetë, kthimi është te Zoti yt!"
    },
    {
      "surah": 96,
      "ayah": 9,
      "verseKey": "96:9",
      "arabic": "أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ",
      "translationSq": "A e ke parë ti (Muhamed) atë që pengon"
    },
    {
      "surah": 96,
      "ayah": 10,
      "verseKey": "96:10",
      "arabic": "عَبْدًا إِذَا صَلَّىٰٓ",
      "translationSq": "robin (Tonë) kur falet?"
    },
    {
      "surah": 96,
      "ayah": 11,
      "verseKey": "96:11",
      "arabic": "أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ",
      "translationSq": "A nuk është ai (robi Ynë) në rrugë të drejtë"
    },
    {
      "surah": 96,
      "ayah": 12,
      "verseKey": "96:12",
      "arabic": "أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ",
      "translationSq": "dhe që urdhëron për devotshmëri?!"
    },
    {
      "surah": 96,
      "ayah": 13,
      "verseKey": "96:13",
      "arabic": "أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ",
      "translationSq": "Mendo, nëse ai (penguesi) mohon dhe kthen kurrizin,"
    },
    {
      "surah": 96,
      "ayah": 14,
      "verseKey": "96:14",
      "arabic": "أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ",
      "translationSq": "a nuk e di ai se Allahu i sheh të gjitha?!"
    },
    {
      "surah": 96,
      "ayah": 15,
      "verseKey": "96:15",
      "arabic": "كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ",
      "translationSq": "Jo, jo! Nëse ai nuk tërhiqet nga kjo, Ne do ta kapim për ballukesh (për ta hedhur në zjarrin e Xhehenemit),"
    },
    {
      "surah": 96,
      "ayah": 16,
      "verseKey": "96:16",
      "arabic": "نَاصِيَةٍ كَـٰذِبَةٍ خَاطِئَةٍ",
      "translationSq": "për ballukesh të gënjeshtarit dhe fajtorit."
    },
    {
      "surah": 96,
      "ayah": 17,
      "verseKey": "96:17",
      "arabic": "فَلْيَدْعُ نَادِيَهُۥ",
      "translationSq": "Atëherë ai le ta thërrasë shoqërinë e vet,"
    },
    {
      "surah": 96,
      "ayah": 18,
      "verseKey": "96:18",
      "arabic": "سَنَدْعُ ٱلزَّبَانِيَةَ",
      "translationSq": "Ne do t’i thërrasim Zebanijet (rojet e Xhehenemit)!"
    },
    {
      "surah": 96,
      "ayah": 19,
      "verseKey": "96:19",
      "arabic": "كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩",
      "translationSq": "Kurrsesi mos iu nënshtro atij (o Muhamed), por bëj sexhde dhe afroju Zotit tënd!"
    }
  ]
}