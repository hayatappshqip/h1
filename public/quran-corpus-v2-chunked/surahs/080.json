{
  "surah": 80,
  "verseCount": 42,
  "verses": [
    {
      "surah": 80,
      "ayah": 1,
      "verseKey": "80:1",
      "arabic": " عَبَسَ وَتَوَلَّىٰٓ",
      "translationSq": "Ai u vrenjt dhe ktheu kurrizin,"
    },
    {
      "surah": 80,
      "ayah": 2,
      "verseKey": "80:2",
      "arabic": "أَن جَآءَهُ ٱلْأَعْمَىٰ",
      "translationSq": "kur i erdhi pranë i verbri."
    },
    {
      "surah": 80,
      "ayah": 3,
      "verseKey": "80:3",
      "arabic": "وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ",
      "translationSq": "E ku e di ti, ndoshta ai dëshironte të pastrohej (nga gjynahet)"
    },
    {
      "surah": 80,
      "ayah": 4,
      "verseKey": "80:4",
      "arabic": "أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ",
      "translationSq": "ose të merrte këshillë, e këshilla t’i sillte dobi atij?!"
    },
    {
      "surah": 80,
      "ayah": 5,
      "verseKey": "80:5",
      "arabic": "أَمَّا مَنِ ٱسْتَغْنَىٰ",
      "translationSq": "Sa për atë që është i pasur,"
    },
    {
      "surah": 80,
      "ayah": 6,
      "verseKey": "80:6",
      "arabic": "فَأَنتَ لَهُۥ تَصَدَّىٰ",
      "translationSq": "ti atij po i kushton vëmendje,"
    },
    {
      "surah": 80,
      "ayah": 7,
      "verseKey": "80:7",
      "arabic": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ",
      "translationSq": "megjithëse nuk ke përgjegjësi, nëse ai nuk dëshiron të pastrohet."
    },
    {
      "surah": 80,
      "ayah": 8,
      "verseKey": "80:8",
      "arabic": "وَأَمَّا مَن جَآءَكَ يَسْعَىٰ",
      "translationSq": "Sa për atë që të vjen duke nxituar"
    },
    {
      "surah": 80,
      "ayah": 9,
      "verseKey": "80:9",
      "arabic": "وَهُوَ يَخْشَىٰ",
      "translationSq": "dhe ndien frikë (nga Allahu),"
    },
    {
      "surah": 80,
      "ayah": 10,
      "verseKey": "80:10",
      "arabic": "فَأَنتَ عَنْهُ تَلَهَّىٰ",
      "translationSq": "ti atij nuk po ia vë veshin."
    },
    {
      "surah": 80,
      "ayah": 11,
      "verseKey": "80:11",
      "arabic": "كَلَّآ إِنَّهَا تَذْكِرَةٌ",
      "translationSq": "Mos vepro ashtu! Në të vërtetë, ky (Kuran) është këshillë,"
    },
    {
      "surah": 80,
      "ayah": 12,
      "verseKey": "80:12",
      "arabic": "فَمَن شَآءَ ذَكَرَهُۥ",
      "translationSq": "pra, kush të dojë, le të marrë këshillë!"
    },
    {
      "surah": 80,
      "ayah": 13,
      "verseKey": "80:13",
      "arabic": "فِى صُحُفٍ مُّكَرَّمَةٍ",
      "translationSq": "Ai ndodhet në Faqe të nderuara,"
    },
    {
      "surah": 80,
      "ayah": 14,
      "verseKey": "80:14",
      "arabic": "مَّرْفُوعَةٍ مُّطَهَّرَةٍۭ",
      "translationSq": "të lartësuara, të pastra,"
    },
    {
      "surah": 80,
      "ayah": 15,
      "verseKey": "80:15",
      "arabic": "بِأَيْدِى سَفَرَةٍ",
      "translationSq": "në duart e shkruesve (engjëj)"
    },
    {
      "surah": 80,
      "ayah": 16,
      "verseKey": "80:16",
      "arabic": "كِرَامٍۭ بَرَرَةٍ",
      "translationSq": "të ndershëm dhe të drejtë."
    },
    {
      "surah": 80,
      "ayah": 17,
      "verseKey": "80:17",
      "arabic": "قُتِلَ ٱلْإِنسَـٰنُ مَآ أَكْفَرَهُۥ",
      "translationSq": "Mallkuar qoftë njeriu! Sa mosmirënjohës që është ai!"
    },
    {
      "surah": 80,
      "ayah": 18,
      "verseKey": "80:18",
      "arabic": "مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ",
      "translationSq": "Prej çfarë gjëje e krijon Allahu atë?"
    },
    {
      "surah": 80,
      "ayah": 19,
      "verseKey": "80:19",
      "arabic": "مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ",
      "translationSq": "Prej pikës së farës e krijon dhe i jep përmasa të rregullta."
    },
    {
      "surah": 80,
      "ayah": 20,
      "verseKey": "80:20",
      "arabic": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ",
      "translationSq": "Më pas ia lehtëson rrugën (e lindjes)"
    },
    {
      "surah": 80,
      "ayah": 21,
      "verseKey": "80:21",
      "arabic": "ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ",
      "translationSq": "e pastaj e vdes dhe i cakton një varr,"
    },
    {
      "surah": 80,
      "ayah": 22,
      "verseKey": "80:22",
      "arabic": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ",
      "translationSq": "dhe, kur të dojë, Ai e ringjall."
    },
    {
      "surah": 80,
      "ayah": 23,
      "verseKey": "80:23",
      "arabic": "كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ",
      "translationSq": "E megjithatë, njeriu ende nuk i ka plotësuar ato që i ka urdhëruar Ai!"
    },
    {
      "surah": 80,
      "ayah": 24,
      "verseKey": "80:24",
      "arabic": "فَلْيَنظُرِ ٱلْإِنسَـٰنُ إِلَىٰ طَعَامِهِۦٓ",
      "translationSq": "Le të mendojë njeriu për ushqimin e vet:"
    },
    {
      "surah": 80,
      "ayah": 25,
      "verseKey": "80:25",
      "arabic": "أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّا",
      "translationSq": "Jemi Ne që lëshojmë ujë me bollëk,"
    },
    {
      "surah": 80,
      "ayah": 26,
      "verseKey": "80:26",
      "arabic": "ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّا",
      "translationSq": "pastaj e çajmë tokën në thellësi"
    },
    {
      "surah": 80,
      "ayah": 27,
      "verseKey": "80:27",
      "arabic": "فَأَنۢبَتْنَا فِيهَا حَبًّا",
      "translationSq": "dhe nxjerrim prej saj drithërat,"
    },
    {
      "surah": 80,
      "ayah": 28,
      "verseKey": "80:28",
      "arabic": "وَعِنَبًا وَقَضْبًا",
      "translationSq": "rrushin e perimet,"
    },
    {
      "surah": 80,
      "ayah": 29,
      "verseKey": "80:29",
      "arabic": "وَزَيْتُونًا وَنَخْلًا",
      "translationSq": "ullirin e palmat,"
    },
    {
      "surah": 80,
      "ayah": 30,
      "verseKey": "80:30",
      "arabic": "وَحَدَآئِقَ غُلْبًا",
      "translationSq": "kopshtet e dendura,"
    },
    {
      "surah": 80,
      "ayah": 31,
      "verseKey": "80:31",
      "arabic": "وَفَـٰكِهَةً وَأَبًّا",
      "translationSq": "pemët dhe gjithë barërat,"
    },
    {
      "surah": 80,
      "ayah": 32,
      "verseKey": "80:32",
      "arabic": "مَّتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ",
      "translationSq": "që t’i gëzoni ju dhe bagëtitë tuaja."
    },
    {
      "surah": 80,
      "ayah": 33,
      "verseKey": "80:33",
      "arabic": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ",
      "translationSq": "Por, kur të vijë Ushtima,"
    },
    {
      "surah": 80,
      "ayah": 34,
      "verseKey": "80:34",
      "arabic": "يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ",
      "translationSq": "atë Ditë njeriu do të ikë nga i vëllai,"
    },
    {
      "surah": 80,
      "ayah": 35,
      "verseKey": "80:35",
      "arabic": "وَأُمِّهِۦ وَأَبِيهِ",
      "translationSq": "nga e ëma dhe nga i ati,"
    },
    {
      "surah": 80,
      "ayah": 36,
      "verseKey": "80:36",
      "arabic": "وَصَـٰحِبَتِهِۦ وَبَنِيهِ",
      "translationSq": "nga e shoqja dhe nga fëmijët e vet."
    },
    {
      "surah": 80,
      "ayah": 37,
      "verseKey": "80:37",
      "arabic": "لِكُلِّ ٱمْرِئٍ مِّنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ",
      "translationSq": "Atë Ditë, secili prej tyre do të ketë aq shqetësim për veten, sa do t’i mjaftojë."
    },
    {
      "surah": 80,
      "ayah": 38,
      "verseKey": "80:38",
      "arabic": "وُجُوهٌ يَوْمَئِذٍ مُّسْفِرَةٌ",
      "translationSq": "Atë Ditë do të ketë fytyra rrëzëllore,"
    },
    {
      "surah": 80,
      "ayah": 39,
      "verseKey": "80:39",
      "arabic": "ضَاحِكَةٌ مُّسْتَبْشِرَةٌ",
      "translationSq": "të qeshura e të gëzuara."
    },
    {
      "surah": 80,
      "ayah": 40,
      "verseKey": "80:40",
      "arabic": "وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ",
      "translationSq": "Atë Ditë do të ketë (edhe) fytyra të pluhurosura,"
    },
    {
      "surah": 80,
      "ayah": 41,
      "verseKey": "80:41",
      "arabic": "تَرْهَقُهَا قَتَرَةٌ",
      "translationSq": "që do t’i mbulojë errësira."
    },
    {
      "surah": 80,
      "ayah": 42,
      "verseKey": "80:42",
      "arabic": "أُو۟لَـٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ",
      "translationSq": "Këta janë jobesimtarët, gjynahqarët."
    }
  ]
}