{
  "surah": 104,
  "verseCount": 9,
  "verses": [
    {
      "surah": 104,
      "ayah": 1,
      "verseKey": "104:1",
      "arabic": " وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ",
      "translationSq": "Mjerë për çdo përqeshës - shpifës,"
    },
    {
      "surah": 104,
      "ayah": 2,
      "verseKey": "104:2",
      "arabic": "ٱلَّذِى جَمَعَ مَالًا وَعَدَّدَهُۥ",
      "translationSq": "që grumbullon pasuri dhe e ruan,"
    },
    {
      "surah": 104,
      "ayah": 3,
      "verseKey": "104:3",
      "arabic": "يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ",
      "translationSq": "duke menduar se ajo pasuri do ta bëjë të pavdekshëm!"
    },
    {
      "surah": 104,
      "ayah": 4,
      "verseKey": "104:4",
      "arabic": "كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ",
      "translationSq": "Jo, aspak! Në të vërtetë, ai do të hidhet në torturën shkatërruese."
    },
    {
      "surah": 104,
      "ayah": 5,
      "verseKey": "104:5",
      "arabic": "وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ",
      "translationSq": "E kush mund të ta shpjegojë ty se çfarë është tortura shkatërruese?"
    },
    {
      "surah": 104,
      "ayah": 6,
      "verseKey": "104:6",
      "arabic": "نَارُ ٱللَّهِ ٱلْمُوقَدَةُ",
      "translationSq": "Ajo është zjarri i Allahut i ndezur fort,"
    },
    {
      "surah": 104,
      "ayah": 7,
      "verseKey": "104:7",
      "arabic": "ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ",
      "translationSq": "i cili depërton deri në zemrën e njeriut."
    },
    {
      "surah": 104,
      "ayah": 8,
      "verseKey": "104:8",
      "arabic": "إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ",
      "translationSq": "Ai do t’i rrethojë ata nga çdo anë,"
    },
    {
      "surah": 104,
      "ayah": 9,
      "verseKey": "104:9",
      "arabic": "فِى عَمَدٍ مُّمَدَّدَةٍۭ",
      "translationSq": "në shtylla të gjata flakëruese."
    }
  ]
}