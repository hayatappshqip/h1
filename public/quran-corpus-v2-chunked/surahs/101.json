{
  "surah": 101,
  "verseCount": 11,
  "verses": [
    {
      "surah": 101,
      "ayah": 1,
      "verseKey": "101:1",
      "arabic": " ٱلْقَارِعَةُ",
      "translationSq": "Gjëmimi i tmerrshëm!"
    },
    {
      "surah": 101,
      "ayah": 2,
      "verseKey": "101:2",
      "arabic": "مَا ٱلْقَارِعَةُ",
      "translationSq": "Ç’është Gjëmimi i tmerrshëm?"
    },
    {
      "surah": 101,
      "ayah": 3,
      "verseKey": "101:3",
      "arabic": "وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ",
      "translationSq": "Kush mund të ta shpjegojë ty se çfarë është Gjëmimi i tmerrshëm?"
    },
    {
      "surah": 101,
      "ayah": 4,
      "verseKey": "101:4",
      "arabic": "يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ",
      "translationSq": "Atë Ditë njerëzit do të jenë si fluturat e shpërndara,"
    },
    {
      "surah": 101,
      "ayah": 5,
      "verseKey": "101:5",
      "arabic": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ",
      "translationSq": "kurse malet si leshi i shprishur."
    },
    {
      "surah": 101,
      "ayah": 6,
      "verseKey": "101:6",
      "arabic": "فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ",
      "translationSq": "Sa i përket atij, veprat e (mira të) të cilit do të rëndojnë në peshore,"
    },
    {
      "surah": 101,
      "ayah": 7,
      "verseKey": "101:7",
      "arabic": "فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ",
      "translationSq": "ai do të ketë një jetë të kënaqur (në Xhenet)."
    },
    {
      "surah": 101,
      "ayah": 8,
      "verseKey": "101:8",
      "arabic": "وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ",
      "translationSq": "E sa i përket atij, veprat e (mira të) të cilit nuk do të rëndojnë në peshore,"
    },
    {
      "surah": 101,
      "ayah": 9,
      "verseKey": "101:9",
      "arabic": "فَأُمُّهُۥ هَاوِيَةٌ",
      "translationSq": "Ai do të ketë si strehim Humnerën (e Xhehenemit)."
    },
    {
      "surah": 101,
      "ayah": 10,
      "verseKey": "101:10",
      "arabic": "وَمَآ أَدْرَىٰكَ مَا هِيَهْ",
      "translationSq": "Kush mund të ta shpjegojë ty se ç’është Humnera (e Xhehenemit)?"
    },
    {
      "surah": 101,
      "ayah": 11,
      "verseKey": "101:11",
      "arabic": "نَارٌ حَامِيَةٌۢ",
      "translationSq": "Ajo është një Zjarr i vrullshëm."
    }
  ]
}