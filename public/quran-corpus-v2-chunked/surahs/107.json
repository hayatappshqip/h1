{
  "surah": 107,
  "verseCount": 7,
  "verses": [
    {
      "surah": 107,
      "ayah": 1,
      "verseKey": "107:1",
      "arabic": " أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ",
      "translationSq": "A e ke parë atë që mohon Ditën e Llogarisë?"
    },
    {
      "surah": 107,
      "ayah": 2,
      "verseKey": "107:2",
      "arabic": "فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ",
      "translationSq": "Ky është ai që i dëbon ashpër jetimët"
    },
    {
      "surah": 107,
      "ayah": 3,
      "verseKey": "107:3",
      "arabic": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ",
      "translationSq": "dhe nuk nxit që t’i jepet ushqim të varfrit."
    },
    {
      "surah": 107,
      "ayah": 4,
      "verseKey": "107:4",
      "arabic": "فَوَيْلٌ لِّلْمُصَلِّينَ",
      "translationSq": "Mjerë për ata, të cilët kur falen,"
    },
    {
      "surah": 107,
      "ayah": 5,
      "verseKey": "107:5",
      "arabic": "ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ",
      "translationSq": "janë të pakujdesshëm për namazet,"
    },
    {
      "surah": 107,
      "ayah": 6,
      "verseKey": "107:6",
      "arabic": "ٱلَّذِينَ هُمْ يُرَآءُونَ",
      "translationSq": "të cilët duan vetëm që të duken"
    },
    {
      "surah": 107,
      "ayah": 7,
      "verseKey": "107:7",
      "arabic": "وَيَمْنَعُونَ ٱلْمَاعُونَ",
      "translationSq": "dhe nuk u japin ndihmë nevojtarëve."
    }
  ]
}