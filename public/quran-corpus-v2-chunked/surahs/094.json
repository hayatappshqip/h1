{
  "surah": 94,
  "verseCount": 8,
  "verses": [
    {
      "surah": 94,
      "ayah": 1,
      "verseKey": "94:1",
      "arabic": " أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ",
      "translationSq": "Vallë, a nuk ta hapëm ty (Muhamed) kraharorin (për të pranuar besimin)"
    },
    {
      "surah": 94,
      "ayah": 2,
      "verseKey": "94:2",
      "arabic": "وَوَضَعْنَا عَنكَ وِزْرَكَ",
      "translationSq": "dhe ta hoqëm barrën,"
    },
    {
      "surah": 94,
      "ayah": 3,
      "verseKey": "94:3",
      "arabic": "ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ",
      "translationSq": "e cila ta rëndonte tepër kurrizin,"
    },
    {
      "surah": 94,
      "ayah": 4,
      "verseKey": "94:4",
      "arabic": "وَرَفَعْنَا لَكَ ذِكْرَكَ",
      "translationSq": "dhe ta ngritëm lart emrin?!"
    },
    {
      "surah": 94,
      "ayah": 5,
      "verseKey": "94:5",
      "arabic": "فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا",
      "translationSq": "Me të vërtetë, pas vështirësisë - vjen lehtësimi!"
    },
    {
      "surah": 94,
      "ayah": 6,
      "verseKey": "94:6",
      "arabic": "إِنَّ مَعَ ٱلْعُسْرِ يُسْرًا",
      "translationSq": "Me të vërtetë, pas vështirësisë - vjen lehtësimi!"
    },
    {
      "surah": 94,
      "ayah": 7,
      "verseKey": "94:7",
      "arabic": "فَإِذَا فَرَغْتَ فَٱنصَبْ",
      "translationSq": "Prandaj, kur të çlirohesh (nga punët e ndryshme), përpiqu fort (në adhurim)"
    },
    {
      "surah": 94,
      "ayah": 8,
      "verseKey": "94:8",
      "arabic": "وَإِلَىٰ رَبِّكَ فَٱرْغَب",
      "translationSq": "dhe vetëm ndaj Zotit tënd përkushtohu!"
    }
  ]
}