- onClick={() => handleOptionSelect(opt.ayahKey)}
- disabled={isAnswered}
- className={`p-3.5 border rounded-xl text-xs sm:text-sm transition-all flex items-center justify-between text-left ${btnStyle}`}
- >
- <span>{opt.label}</span>
- {isAnswered && (
