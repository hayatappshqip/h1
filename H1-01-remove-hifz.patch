- <CheckCircle2 className="w-4 h-4 text-emerald-400 shrink-0 ml-2" />
- ) : isChosen ? (
- <XCircle className="w-4 h-4 text-red-400 shrink-0 ml-2" />
- ) : null
- )}
- </button>
- );
- })}
- </div>
-
- {/* Explanation after answering */}
- {isAnswered && (
