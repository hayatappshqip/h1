-export type ReviewMode = 'ADAPTIVE' | 'WEEKLY_MANZIL' | 'MONTHLY_JUZ';
-
-// The seven Manzils (approximate start surahs/ayahs)
-// 1: 1-4, 2: 5-9, 3: 10-16, 4: 17-25, 5: 26-36, 6: 37-49, 7: 50-114
-export const MANZIL_STARTS = [
- { surah: 1, ayah: 1 },
- { surah: 5, ayah: 1 },
- { surah: 10, ayah: 1 },
- { surah: 17, ayah: 1 },
- { surah: 26, ayah: 1 },
- { surah: 37, ayah: 1 },
- { surah: 50, ayah: 1 },
-];
